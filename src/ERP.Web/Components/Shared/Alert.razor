@*
    Reusable Alert Component
    Usage: <Alert Type="success" Message="Operation completed successfully!" />
*@

@if (IsVisible)
{
    <div class="@AlertClass" role="alert">
        <div class="flex items-start">
            <!-- Icon -->
            <div class="flex-shrink-0">
                @switch (Type)
                {
                    case "success":
                        <svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                        break;
                    case "warning":
                        <svg class="w-5 h-5 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
                        </svg>
                        break;
                    case "error":
                        <svg class="w-5 h-5 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                        break;
                    case "info":
                        <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                        break;
                }
            </div>

            <!-- Content -->
            <div class="ml-3 flex-1">
                @if (!string.IsNullOrEmpty(Title))
                {
                    <h3 class="@TitleClass">@Title</h3>
                }
                @if (!string.IsNullOrEmpty(Message))
                {
                    <p class="@MessageClass">@Message</p>
                }
                @if (ChildContent != null)
                {
                    <div class="@MessageClass">
                        @ChildContent
                    </div>
                }
            </div>

            <!-- Close button -->
            @if (Dismissible)
            {
                <div class="ml-auto pl-3">
                    <button @onclick="Dismiss" class="@CloseButtonClass">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                        </svg>
                    </button>
                </div>
            }
        </div>
    </div>
}

@code {
    /// <summary>
    /// Alert type (success, warning, error, info)
    /// </summary>
    [Parameter]
    public string Type { get; set; } = "info";

    /// <summary>
    /// Alert title
    /// </summary>
    [Parameter]
    public string? Title { get; set; }

    /// <summary>
    /// Alert message
    /// </summary>
    [Parameter]
    public string? Message { get; set; }

    /// <summary>
    /// Custom content
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Whether the alert can be dismissed
    /// </summary>
    [Parameter]
    public bool Dismissible { get; set; } = true;

    /// <summary>
    /// Additional CSS classes
    /// </summary>
    [Parameter]
    public string? Class { get; set; }

    /// <summary>
    /// Event callback when alert is dismissed
    /// </summary>
    [Parameter]
    public EventCallback OnDismiss { get; set; }

    private bool IsVisible { get; set; } = true;

    private string AlertClass
    {
        get
        {
            var baseClass = "alert p-4 rounded-lg mb-4";

            var typeClass = Type switch
            {
                "success" => "alert-success",
                "warning" => "alert-warning",
                "error" => "alert-error",
                "info" => "alert-info",
                _ => "alert-info"
            };

            return $"{baseClass} {typeClass} {Class}".Trim();
        }
    }

    private string TitleClass => Type switch
    {
        "success" => "text-sm font-semibold text-green-800",
        "warning" => "text-sm font-semibold text-yellow-800",
        "error" => "text-sm font-semibold text-red-800",
        "info" => "text-sm font-semibold text-blue-800",
        _ => "text-sm font-semibold text-blue-800"
    };

    private string MessageClass
    {
        get
        {
            var marginClass = !string.IsNullOrEmpty(Title) ? "mt-1" : "";
            var colorClass = Type switch
            {
                "success" => "text-green-700",
                "warning" => "text-yellow-700",
                "error" => "text-red-700",
                "info" => "text-blue-700",
                _ => "text-blue-700"
            };
            return $"text-sm {colorClass} {marginClass}".Trim();
        }
    }

    private string CloseButtonClass => Type switch
    {
        "success" => "text-green-500 hover:text-green-700",
        "warning" => "text-yellow-500 hover:text-yellow-700",
        "error" => "text-red-500 hover:text-red-700",
        "info" => "text-blue-500 hover:text-blue-700",
        _ => "text-blue-500 hover:text-blue-700"
    };

    private async Task Dismiss()
    {
        IsVisible = false;
        await OnDismiss.InvokeAsync();
    }
}
