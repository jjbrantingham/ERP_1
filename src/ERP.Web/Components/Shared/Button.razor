@*
    Reusable Button Component
    Usage: <Button Variant="primary" OnClick="HandleClick">Click Me</Button>
*@

<button type="@Type" class="@ButtonClass" @onclick="OnClick" disabled="@Disabled">
    @if (IsLoading)
    {
        <span class="spinner" style="width: 1rem; height: 1rem; margin-right: 0.5rem;"></span>
    }
    @ChildContent
</button>

@code {
    /// <summary>
    /// Button variant (primary, secondary, danger, success, warning)
    /// </summary>
    [Parameter]
    public string Variant { get; set; } = "primary";

    /// <summary>
    /// Button size (sm, md, lg)
    /// </summary>
    [Parameter]
    public string Size { get; set; } = "md";

    /// <summary>
    /// Button type (button, submit, reset)
    /// </summary>
    [Parameter]
    public string Type { get; set; } = "button";

    /// <summary>
    /// Whether the button is disabled
    /// </summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>
    /// Whether the button is in loading state
    /// </summary>
    [Parameter]
    public bool IsLoading { get; set; }

    /// <summary>
    /// Additional CSS classes
    /// </summary>
    [Parameter]
    public string? Class { get; set; }

    /// <summary>
    /// Click event handler
    /// </summary>
    [Parameter]
    public EventCallback<MouseEventArgs> OnClick { get; set; }

    /// <summary>
    /// Button content
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private string ButtonClass
    {
        get
        {
            var baseClass = "btn inline-flex items-center justify-center font-medium rounded-lg border transition-colors focus:outline-none focus:ring-2 focus:ring-offset-2";

            var variantClass = Variant switch
            {
                "primary" => "bg-blue-600 text-white hover:bg-blue-700 border-transparent focus:ring-blue-500",
                "secondary" => "bg-gray-200 text-gray-700 hover:bg-gray-300 border-transparent focus:ring-gray-500",
                "danger" => "bg-red-600 text-white hover:bg-red-700 border-transparent focus:ring-red-500",
                "success" => "bg-green-600 text-white hover:bg-green-700 border-transparent focus:ring-green-500",
                "warning" => "bg-yellow-500 text-white hover:bg-yellow-600 border-transparent focus:ring-yellow-500",
                "outline" => "bg-white text-gray-700 hover:bg-gray-50 border-gray-300 focus:ring-blue-500",
                _ => "bg-blue-600 text-white hover:bg-blue-700 border-transparent focus:ring-blue-500"
            };

            var sizeClass = Size switch
            {
                "sm" => "px-3 py-1.5 text-sm",
                "md" => "px-4 py-2 text-base",
                "lg" => "px-6 py-3 text-lg",
                _ => "px-4 py-2 text-base"
            };

            var disabledClass = Disabled || IsLoading ? "opacity-50 cursor-not-allowed" : "cursor-pointer";

            return $"{baseClass} {variantClass} {sizeClass} {disabledClass} {Class}".Trim();
        }
    }
}
