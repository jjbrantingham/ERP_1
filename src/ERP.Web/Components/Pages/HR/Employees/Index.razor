@page "/hr/employees"

<div class="container mx-auto px-4 py-8">
    <!-- Breadcrumb -->
    <nav class="text-sm text-gray-600 mb-4">
        <a href="/" class="hover:text-blue-600">Home</a>
        <span class="mx-2">/</span>
        <a href="/hr/employees" class="hover:text-blue-600">Human Resources</a>
        <span class="mx-2">/</span>
        <span class="text-gray-900 font-medium">Employees</span>
    </nav>

    <!-- Page Header -->
    <div class="flex items-center justify-between mb-6">
        <div>
            <h1 class="text-3xl font-bold text-gray-900">Employees</h1>
            <p class="mt-1 text-sm text-gray-600">Manage employee records and information</p>
        </div>
        <Button Variant="primary" OnClick="NavigateToCreate">
            <svg class="w-5 h-5 mr-2 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
            </svg>
            Add Employee
        </Button>
    </div>

    <!-- Search and Filter Bar -->
    <Card Class="mb-6">
        <Body>
            <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
                <FormField Label="Search">
                    <input type="text"
                           @bind="searchTerm"
                           @bind:event="oninput"
                           @onkeyup="HandleSearch"
                           class="form-input"
                           placeholder="Search by name or employee #..." />
                </FormField>

                <FormField Label="Department">
                    <select @bind="filterDepartment" @bind:after="ApplyFilters" class="form-input">
                        <option value="">All Departments</option>
                        <option value="Engineering">Engineering</option>
                        <option value="Sales">Sales</option>
                        <option value="Marketing">Marketing</option>
                        <option value="Finance">Finance</option>
                        <option value="HR">Human Resources</option>
                        <option value="Operations">Operations</option>
                    </select>
                </FormField>

                <FormField Label="Status">
                    <select @bind="filterStatus" @bind:after="ApplyFilters" class="form-input">
                        <option value="">All Status</option>
                        <option value="Active">Active</option>
                        <option value="OnLeave">On Leave</option>
                        <option value="Terminated">Terminated</option>
                    </select>
                </FormField>

                <FormField Label="&nbsp;">
                    <Button Variant="outline" OnClick="ClearFilters" Class="w-full">
                        Clear Filters
                    </Button>
                </FormField>
            </div>
        </Body>
    </Card>

    <!-- Employees Table -->
    @if (isLoading)
    {
        <div class="flex justify-center py-12">
            <LoadingSpinner />
        </div>
    }
    else
    {
        <Card>
            <Body>
                <div class="overflow-x-auto">
                    <table class="min-w-full divide-y divide-gray-200">
                        <thead class="bg-gray-50">
                            <tr>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Employee</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Department</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Title</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Hire Date</th>
                                <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="bg-white divide-y divide-gray-200">
                            @if (filteredEmployees?.Any() == true)
                            {
                                @foreach (var emp in filteredEmployees)
                                {
                                    <tr class="hover:bg-gray-50">
                                        <td class="px-6 py-4 whitespace-nowrap">
                                            <div class="flex items-center">
                                                <div class="flex-shrink-0 h-10 w-10">
                                                    <div class="h-10 w-10 rounded-full bg-blue-500 flex items-center justify-center text-white font-semibold">
                                                        @GetInitials(emp.FullName)
                                                    </div>
                                                </div>
                                                <div class="ml-4">
                                                    <div class="text-sm font-medium text-gray-900">@emp.FullName</div>
                                                    <div class="text-sm text-gray-500">@emp.EmployeeNumber</div>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">@emp.Department</td>
                                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">@emp.JobTitle</td>
                                        <td class="px-6 py-4 whitespace-nowrap">
                                            <span class="@GetStatusBadgeClass(emp.Status)">@emp.Status</span>
                                        </td>
                                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                            @emp.HireDate.ToString("MMM dd, yyyy")
                                        </td>
                                        <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                                            <div class="flex items-center justify-end space-x-2">
                                                <Button Variant="outline" Size="sm" OnClick="() => ViewDetails(emp.Id)">View</Button>
                                                <Button Variant="outline" Size="sm" OnClick="() => EditEmployee(emp.Id)">Edit</Button>
                                                <Button Variant="danger" Size="sm" OnClick="() => ConfirmDelete(emp.Id, emp.FullName)">Delete</Button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="6" class="px-6 py-12 text-center text-gray-500">
                                        No employees found
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Pagination -->
                @if (totalItems > 10)
                {
                    <div class="flex items-center justify-between px-4 py-3 border-t border-gray-200">
                        <div class="text-sm text-gray-700">
                            Showing @((currentPage - 1) * 10 + 1) to @Math.Min(currentPage * 10, totalItems) of @totalItems results
                        </div>
                        <div class="flex space-x-2">
                            <Button Variant="outline" Size="sm" OnClick="PreviousPage" Disabled="@(currentPage <= 1)">Previous</Button>
                            <Button Variant="outline" Size="sm" OnClick="NextPage" Disabled="@(currentPage * 10 >= totalItems)">Next</Button>
                        </div>
                    </div>
                }
            </Body>
        </Card>
    }
</div>

<!-- Delete Confirmation Modal -->
<Modal @bind-IsOpen="showDeleteModal" Title="Confirm Delete" Size="md">
    <Body>
        <div class="text-center py-4">
            <div class="mx-auto flex items-center justify-center h-12 w-12 rounded-full bg-red-100 mb-4">
                <svg class="h-6 w-6 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
                </svg>
            </div>
            <h3 class="text-lg font-semibold text-gray-900 mb-2">Delete Employee</h3>
            <p class="text-sm text-gray-600">
                Are you sure you want to delete <strong>@employeeToDelete</strong>?
                This action cannot be undone.
            </p>
        </div>
    </Body>
    <Footer>
        <Button Variant="secondary" OnClick="CancelDelete">Cancel</Button>
        <Button Variant="danger" OnClick="DeleteEmployee" IsLoading="@isDeleting">Delete</Button>
    </Footer>
</Modal>

@code {
    [Inject] private NavigationManager? NavigationManager { get; set; }

    private bool isLoading = true;
    private bool isDeleting = false;
    private bool showDeleteModal = false;
    private string searchTerm = string.Empty;
    private string filterDepartment = string.Empty;
    private string filterStatus = string.Empty;
    private int currentPage = 1;
    private int totalItems = 0;
    private long deleteEmployeeId = 0;
    private string employeeToDelete = string.Empty;

    private List<EmployeeListItem>? allEmployees;
    private List<EmployeeListItem>? filteredEmployees;

    private class EmployeeListItem
    {
        public long Id { get; set; }
        public string EmployeeNumber { get; set; } = string.Empty;
        public string FullName { get; set; } = string.Empty;
        public string? Department { get; set; }
        public string? JobTitle { get; set; }
        public string Status { get; set; } = string.Empty;
        public DateTime HireDate { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadEmployees();
    }

    private async Task LoadEmployees()
    {
        isLoading = true;
        try
        {
            await Task.Delay(500);

            allEmployees = new List<EmployeeListItem>
            {
                new() { Id = 1, EmployeeNumber = "EMP-001", FullName = "John Smith", Department = "Engineering", JobTitle = "Senior Developer", Status = "Active", HireDate = DateTime.Now.AddYears(-3) },
                new() { Id = 2, EmployeeNumber = "EMP-002", FullName = "Sarah Johnson", Department = "Sales", JobTitle = "Sales Manager", Status = "Active", HireDate = DateTime.Now.AddYears(-2) },
                new() { Id = 3, EmployeeNumber = "EMP-003", FullName = "Michael Chen", Department = "Engineering", JobTitle = "Tech Lead", Status = "Active", HireDate = DateTime.Now.AddYears(-4) },
                new() { Id = 4, EmployeeNumber = "EMP-004", FullName = "Emily Davis", Department = "Marketing", JobTitle = "Marketing Specialist", Status = "OnLeave", HireDate = DateTime.Now.AddYears(-1) },
                new() { Id = 5, EmployeeNumber = "EMP-005", FullName = "David Wilson", Department = "Finance", JobTitle = "Financial Analyst", Status = "Active", HireDate = DateTime.Now.AddMonths(-8) },
                new() { Id = 6, EmployeeNumber = "EMP-006", FullName = "Lisa Anderson", Department = "HR", JobTitle = "HR Manager", Status = "Active", HireDate = DateTime.Now.AddYears(-5) },
                new() { Id = 7, EmployeeNumber = "EMP-007", FullName = "Robert Taylor", Department = "Operations", JobTitle = "Operations Lead", Status = "Active", HireDate = DateTime.Now.AddYears(-2) },
                new() { Id = 8, EmployeeNumber = "EMP-008", FullName = "Jennifer Martinez", Department = "Engineering", JobTitle = "Junior Developer", Status = "Active", HireDate = DateTime.Now.AddMonths(-6) },
                new() { Id = 9, EmployeeNumber = "EMP-009", FullName = "William Brown", Department = "Sales", JobTitle = "Account Executive", Status = "Active", HireDate = DateTime.Now.AddMonths(-4) },
                new() { Id = 10, EmployeeNumber = "EMP-010", FullName = "Amanda Garcia", Department = "Marketing", JobTitle = "Content Manager", Status = "Terminated", HireDate = DateTime.Now.AddYears(-1) },
            };

            ApplyFilters();
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ApplyFilters()
    {
        filteredEmployees = allEmployees;

        if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            var search = searchTerm.ToLower();
            filteredEmployees = filteredEmployees?
                .Where(e => e.FullName.ToLower().Contains(search) || e.EmployeeNumber.ToLower().Contains(search))
                .ToList();
        }

        if (!string.IsNullOrWhiteSpace(filterDepartment))
        {
            filteredEmployees = filteredEmployees?.Where(e => e.Department == filterDepartment).ToList();
        }

        if (!string.IsNullOrWhiteSpace(filterStatus))
        {
            filteredEmployees = filteredEmployees?.Where(e => e.Status == filterStatus).ToList();
        }

        totalItems = filteredEmployees?.Count ?? 0;
        filteredEmployees = filteredEmployees?.Skip((currentPage - 1) * 10).Take(10).ToList();
    }

    private void HandleSearch() { currentPage = 1; ApplyFilters(); }
    private void ClearFilters() { searchTerm = filterDepartment = filterStatus = string.Empty; currentPage = 1; ApplyFilters(); }
    private void PreviousPage() { if (currentPage > 1) { currentPage--; ApplyFilters(); } }
    private void NextPage() { if (currentPage * 10 < totalItems) { currentPage++; ApplyFilters(); } }

    private void NavigateToCreate() => NavigationManager?.NavigateTo("/hr/employees/create");
    private void ViewDetails(long id) => NavigationManager?.NavigateTo($"/hr/employees/{id}/details");
    private void EditEmployee(long id) => NavigationManager?.NavigateTo($"/hr/employees/{id}");

    private void ConfirmDelete(long id, string name) { deleteEmployeeId = id; employeeToDelete = name; showDeleteModal = true; }
    private void CancelDelete() { showDeleteModal = false; }

    private async Task DeleteEmployee()
    {
        isDeleting = true;
        try
        {
            await Task.Delay(1000);
            allEmployees?.RemoveAll(e => e.Id == deleteEmployeeId);
            ApplyFilters();
            showDeleteModal = false;
        }
        finally { isDeleting = false; }
    }

    private string GetInitials(string name)
    {
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2) return $"{parts[0][0]}{parts[1][0]}".ToUpper();
        return parts.Length == 1 ? parts[0].Substring(0, Math.Min(2, parts[0].Length)).ToUpper() : "??";
    }

    private string GetStatusBadgeClass(string status) => status switch
    {
        "Active" => "px-3 py-1 rounded-full text-xs font-medium bg-green-100 text-green-800",
        "OnLeave" => "px-3 py-1 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800",
        "Terminated" => "px-3 py-1 rounded-full text-xs font-medium bg-red-100 text-red-800",
        _ => "px-3 py-1 rounded-full text-xs font-medium bg-gray-100 text-gray-800"
    };
}
