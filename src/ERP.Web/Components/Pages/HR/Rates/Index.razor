@page "/hr/rates"

<div class="container mx-auto px-4 py-8">
    <!-- Breadcrumb -->
    <nav class="text-sm text-gray-600 mb-4">
        <a href="/" class="hover:text-blue-600">Home</a>
        <span class="mx-2">/</span>
        <a href="/hr/employees" class="hover:text-blue-600">Human Resources</a>
        <span class="mx-2">/</span>
        <span class="text-gray-900 font-medium">Rates</span>
    </nav>

    <!-- Page Header -->
    <div class="flex items-center justify-between mb-6">
        <div>
            <h1 class="text-3xl font-bold text-gray-900">Employee Rates</h1>
            <p class="mt-1 text-sm text-gray-600">Manage cost and bill rates for employees</p>
        </div>
        <Button Variant="primary" OnClick="NavigateToCreate">
            <svg class="w-5 h-5 mr-2 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
            </svg>
            Add Rate
        </Button>
    </div>

    <!-- Filters -->
    <Card Class="mb-6">
        <Body>
            <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
                <FormField Label="Search Employee">
                    <input type="text" @bind="searchTerm" @bind:event="oninput" class="form-input" placeholder="Search by name..." />
                </FormField>

                <FormField Label="Resource Type">
                    <select @bind="filterResourceType" @bind:after="ApplyFilters" class="form-input">
                        <option value="">All Types</option>
                        <option value="Senior Developer">Senior Developer</option>
                        <option value="Developer">Developer</option>
                        <option value="Project Manager">Project Manager</option>
                        <option value="Business Analyst">Business Analyst</option>
                        <option value="QA Engineer">QA Engineer</option>
                    </select>
                </FormField>

                <FormField Label="Status">
                    <select @bind="filterStatus" @bind:after="ApplyFilters" class="form-input">
                        <option value="">All</option>
                        <option value="Current">Current Only</option>
                        <option value="Historical">Historical</option>
                    </select>
                </FormField>

                <FormField Label="&nbsp;">
                    <Button Variant="outline" OnClick="ClearFilters" Class="w-full">Clear Filters</Button>
                </FormField>
            </div>
        </Body>
    </Card>

    @if (isLoading)
    {
        <div class="flex justify-center py-12">
            <LoadingSpinner />
        </div>
    }
    else
    {
        <Card>
            <Body>
                <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-gray-50">
                        <tr>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Employee</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Resource Type</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Effective Date</th>
                            <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase">Cost Rate</th>
                            <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase">Bill Rate</th>
                            <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase">Markup</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Status</th>
                            <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-gray-200">
                        @foreach (var rate in filteredRates ?? rates)
                        {
                            <tr class="hover:bg-gray-50">
                                <td class="px-6 py-4">
                                    <div class="flex items-center">
                                        <div class="h-8 w-8 rounded-full bg-blue-500 flex items-center justify-center text-white text-sm font-medium">
                                            @GetInitials(rate.EmployeeName)
                                        </div>
                                        <div class="ml-3">
                                            <div class="text-sm font-medium text-gray-900">@rate.EmployeeName</div>
                                            <div class="text-xs text-gray-500">@rate.EmployeeNumber</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="px-6 py-4 text-sm text-gray-900">@rate.ResourceType</td>
                                <td class="px-6 py-4 text-sm text-gray-500">@rate.EffectiveDate.ToString("MMM dd, yyyy")</td>
                                <td class="px-6 py-4 text-sm text-right text-gray-900">@rate.CostRate.ToString("C2")/hr</td>
                                <td class="px-6 py-4 text-sm text-right text-gray-900">@rate.BillRate.ToString("C2")/hr</td>
                                <td class="px-6 py-4 text-sm text-right @(rate.Markup >= 50 ? "text-green-600" : "text-yellow-600")">
                                    @rate.Markup.ToString("F0")%
                                </td>
                                <td class="px-6 py-4">
                                    <span class="@(rate.IsCurrent ? "px-2 py-1 rounded-full text-xs font-medium bg-green-100 text-green-800" : "px-2 py-1 rounded-full text-xs font-medium bg-gray-100 text-gray-800")">
                                        @(rate.IsCurrent ? "Current" : "Historical")
                                    </span>
                                </td>
                                <td class="px-6 py-4 text-right">
                                    <Button Variant="outline" Size="sm" OnClick="() => EditRate(rate.Id)">Edit</Button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </Body>
        </Card>
    }
</div>

@code {
    [Inject] private NavigationManager? NavigationManager { get; set; }

    private bool isLoading = true;
    private string searchTerm = string.Empty;
    private string filterResourceType = string.Empty;
    private string filterStatus = string.Empty;
    private List<RateItem> rates = new();
    private List<RateItem>? filteredRates;

    private class RateItem
    {
        public long Id { get; set; }
        public string EmployeeNumber { get; set; } = string.Empty;
        public string EmployeeName { get; set; } = string.Empty;
        public string ResourceType { get; set; } = string.Empty;
        public DateTime EffectiveDate { get; set; }
        public decimal CostRate { get; set; }
        public decimal BillRate { get; set; }
        public decimal Markup => CostRate > 0 ? ((BillRate - CostRate) / CostRate) * 100 : 0;
        public bool IsCurrent { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            await Task.Delay(500);
            rates = new List<RateItem>
            {
                new() { Id = 1, EmployeeNumber = "EMP-001", EmployeeName = "John Smith", ResourceType = "Senior Developer", EffectiveDate = DateTime.Now.AddMonths(-6), CostRate = 75, BillRate = 150, IsCurrent = true },
                new() { Id = 2, EmployeeNumber = "EMP-002", EmployeeName = "Sarah Johnson", ResourceType = "Project Manager", EffectiveDate = DateTime.Now.AddMonths(-3), CostRate = 80, BillRate = 175, IsCurrent = true },
                new() { Id = 3, EmployeeNumber = "EMP-003", EmployeeName = "Michael Chen", ResourceType = "Senior Developer", EffectiveDate = DateTime.Now.AddMonths(-12), CostRate = 85, BillRate = 200, IsCurrent = true },
                new() { Id = 4, EmployeeNumber = "EMP-005", EmployeeName = "David Wilson", ResourceType = "Business Analyst", EffectiveDate = DateTime.Now.AddMonths(-4), CostRate = 65, BillRate = 150, IsCurrent = true },
                new() { Id = 5, EmployeeNumber = "EMP-008", EmployeeName = "Jennifer Martinez", ResourceType = "Developer", EffectiveDate = DateTime.Now.AddMonths(-6), CostRate = 50, BillRate = 100, IsCurrent = true },
                new() { Id = 6, EmployeeNumber = "EMP-001", EmployeeName = "John Smith", ResourceType = "Developer", EffectiveDate = DateTime.Now.AddYears(-2), CostRate = 55, BillRate = 110, IsCurrent = false },
            };
            ApplyFilters();
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ApplyFilters()
    {
        filteredRates = rates;

        if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            var search = searchTerm.ToLower();
            filteredRates = filteredRates.Where(r => r.EmployeeName.ToLower().Contains(search)).ToList();
        }

        if (!string.IsNullOrWhiteSpace(filterResourceType))
            filteredRates = filteredRates.Where(r => r.ResourceType == filterResourceType).ToList();

        if (!string.IsNullOrWhiteSpace(filterStatus))
        {
            bool showCurrent = filterStatus == "Current";
            filteredRates = filteredRates.Where(r => r.IsCurrent == showCurrent).ToList();
        }
    }

    private void ClearFilters() { searchTerm = filterResourceType = filterStatus = string.Empty; ApplyFilters(); }
    private void NavigateToCreate() => NavigationManager?.NavigateTo("/hr/rates/create");
    private void EditRate(long id) => NavigationManager?.NavigateTo($"/hr/rates/{id}");

    private string GetInitials(string name)
    {
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2) return $"{parts[0][0]}{parts[1][0]}".ToUpper();
        return parts.Length == 1 ? parts[0].Substring(0, Math.Min(2, parts[0].Length)).ToUpper() : "??";
    }
}
