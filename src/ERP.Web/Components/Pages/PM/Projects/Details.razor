@page "/pm/projects/{Id:int}/details"

<div class="container mx-auto px-4 py-8">
    <!-- Breadcrumb -->
    <nav class="text-sm text-gray-600 mb-4">
        <a href="/" class="hover:text-teal-600">Home</a>
        <span class="mx-2">/</span>
        <a href="/pm/projects" class="hover:text-teal-600">Projects</a>
        <span class="mx-2">/</span>
        <span class="text-gray-900 font-medium">Project Details</span>
    </nav>

    @if (isLoading)
    {
        <LoadingSpinner />
    }
    else if (project == null)
    {
        <Alert Type="error">Project not found</Alert>
    }
    else
    {
        <!-- Page Header -->
        <div class="flex flex-col md:flex-row md:items-start md:justify-between mb-6">
            <div class="flex items-start space-x-4">
                <div class="flex-shrink-0 h-16 w-16 rounded-lg bg-teal-500 flex items-center justify-center text-white text-2xl font-bold">
                    @GetInitials(project.Name)
                </div>
                <div>
                    <div class="flex items-center space-x-3">
                        <h1 class="text-2xl font-bold text-gray-900">@project.Name</h1>
                        <span class="@GetStatusBadgeClass(project.Status)">@GetStatusDisplay(project.Status)</span>
                    </div>
                    <p class="text-sm text-gray-500 mt-1">
                        <span class="font-mono text-teal-600 font-medium">@project.ProjectNumber</span>
                        @if (!string.IsNullOrEmpty(project.ClientName))
                        {
                            <span class="mx-2">•</span>
                            <a href="/crm/clients/@project.ClientId/details" class="hover:text-teal-600">@project.ClientName</a>
                        }
                    </p>
                </div>
            </div>
            <div class="mt-4 md:mt-0 flex space-x-3">
                <Button Variant="secondary" OnClick="GoBack">
                    <svg class="w-4 h-4 mr-2 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                    </svg>
                    Back
                </Button>
                <Button Variant="primary" OnClick="EditProject">
                    <svg class="w-4 h-4 mr-2 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                    </svg>
                    Edit
                </Button>
            </div>
        </div>

        <!-- Quick Stats -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
            <Card>
                <Body>
                    <div class="text-center">
                        <p class="text-sm text-gray-500">Progress</p>
                        <p class="text-2xl font-bold text-teal-600">@project.PercentComplete%</p>
                        <div class="mt-2 bg-gray-200 rounded-full h-2">
                            <div class="bg-teal-500 h-2 rounded-full" style="width: @(project.PercentComplete)%"></div>
                        </div>
                    </div>
                </Body>
            </Card>
            <Card>
                <Body>
                    <div class="text-center">
                        <p class="text-sm text-gray-500">Budget</p>
                        <p class="text-2xl font-bold text-gray-900">@project.Budget.ToString("C0")</p>
                        <p class="text-xs text-gray-400">@project.BillingMode</p>
                    </div>
                </Body>
            </Card>
            <Card>
                <Body>
                    <div class="text-center">
                        <p class="text-sm text-gray-500">Hours Logged</p>
                        <p class="text-2xl font-bold text-gray-900">@hoursLogged.ToString("N0")</p>
                        <p class="text-xs text-gray-400">of @project.BudgetedHours budgeted</p>
                    </div>
                </Body>
            </Card>
            <Card>
                <Body>
                    <div class="text-center">
                        <p class="text-sm text-gray-500">Days Remaining</p>
                        <p class="text-2xl font-bold @(daysRemaining < 30 ? "text-orange-600" : "text-gray-900")">@daysRemaining</p>
                        <p class="text-xs text-gray-400">@project.EndDate?.ToString("MMM dd, yyyy")</p>
                    </div>
                </Body>
            </Card>
        </div>

        <!-- Tabs -->
        <div class="border-b border-gray-200 mb-6">
            <nav class="-mb-px flex space-x-8">
                <button @onclick="() => activeTab = 0" class="@GetTabClass(0)">Overview</button>
                <button @onclick="() => activeTab = 1" class="@GetTabClass(1)">WBS</button>
                <button @onclick="() => activeTab = 2" class="@GetTabClass(2)">Team</button>
                <button @onclick="() => activeTab = 3" class="@GetTabClass(3)">Time & Expenses</button>
                <button @onclick="() => activeTab = 4" class="@GetTabClass(4)">Financials</button>
                <button @onclick="() => activeTab = 5" class="@GetTabClass(5)">Documents</button>
            </nav>
        </div>

        <!-- Tab Content -->
        @switch (activeTab)
        {
            case 0:
                @RenderOverviewTab()
                break;
            case 1:
                @RenderWBSTab()
                break;
            case 2:
                @RenderTeamTab()
                break;
            case 3:
                @RenderTimeExpensesTab()
                break;
            case 4:
                @RenderFinancialsTab()
                break;
            case 5:
                @RenderDocumentsTab()
                break;
        }
    }
</div>

@code {
    [Parameter] public int Id { get; set; }
    [Inject] private NavigationManager? NavigationManager { get; set; }

    private ProjectDetail? project;
    private bool isLoading = true;
    private int activeTab = 0;
    private decimal hoursLogged = 856;
    private int daysRemaining = 142;

    private class ProjectDetail
    {
        public long Id { get; set; }
        public string ProjectNumber { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
        public string? Description { get; set; }
        public string Type { get; set; } = string.Empty;
        public string Status { get; set; } = string.Empty;
        public long? ClientId { get; set; }
        public string? ClientName { get; set; }
        public string? ProjectManager { get; set; }
        public decimal Budget { get; set; }
        public decimal BudgetedHours { get; set; }
        public string BillingMode { get; set; } = string.Empty;
        public int PercentComplete { get; set; }
        public DateTime StartDate { get; set; }
        public DateTime? EndDate { get; set; }
    }

    private class WBSItem
    {
        public long Id { get; set; }
        public string Code { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
        public string Type { get; set; } = string.Empty;
        public decimal BudgetedHours { get; set; }
        public decimal ActualHours { get; set; }
        public int PercentComplete { get; set; }
        public bool IsExpanded { get; set; }
        public List<WBSItem> Children { get; set; } = new();
    }

    private class TeamMember
    {
        public long Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public string Role { get; set; } = string.Empty;
        public string ResourceType { get; set; } = string.Empty;
        public decimal AllocatedHours { get; set; }
        public decimal LoggedHours { get; set; }
        public decimal BillRate { get; set; }
    }

    private List<WBSItem> wbsItems = new();
    private List<TeamMember> teamMembers = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadProject();
    }

    private async Task LoadProject()
    {
        isLoading = true;
        try
        {
            await Task.Delay(500);

            project = new ProjectDetail
            {
                Id = Id,
                ProjectNumber = "PRJ-2024-001",
                Name = "ERP Implementation",
                Description = "Complete ERP system implementation including HR, CRM, Financial, and Project Management modules",
                Type = "Billable",
                Status = "Active",
                ClientId = 1,
                ClientName = "Acme Corporation",
                ProjectManager = "Alice Johnson",
                Budget = 250000,
                BudgetedHours = 2000,
                BillingMode = "T&M",
                PercentComplete = 45,
                StartDate = DateTime.Now.AddMonths(-3),
                EndDate = DateTime.Now.AddMonths(6)
            };

            wbsItems = new List<WBSItem>
            {
                new()
                {
                    Id = 1, Code = "1.0", Name = "Discovery & Planning", Type = "Phase", BudgetedHours = 200, ActualHours = 195, PercentComplete = 100, IsExpanded = true,
                    Children = new()
                    {
                        new() { Id = 11, Code = "1.1", Name = "Requirements Gathering", Type = "Task", BudgetedHours = 80, ActualHours = 85, PercentComplete = 100 },
                        new() { Id = 12, Code = "1.2", Name = "Gap Analysis", Type = "Task", BudgetedHours = 60, ActualHours = 55, PercentComplete = 100 },
                        new() { Id = 13, Code = "1.3", Name = "Project Planning", Type = "Task", BudgetedHours = 60, ActualHours = 55, PercentComplete = 100 },
                    }
                },
                new()
                {
                    Id = 2, Code = "2.0", Name = "Design & Architecture", Type = "Phase", BudgetedHours = 300, ActualHours = 280, PercentComplete = 95, IsExpanded = true,
                    Children = new()
                    {
                        new() { Id = 21, Code = "2.1", Name = "System Architecture", Type = "Task", BudgetedHours = 120, ActualHours = 115, PercentComplete = 100 },
                        new() { Id = 22, Code = "2.2", Name = "Database Design", Type = "Task", BudgetedHours = 100, ActualHours = 95, PercentComplete = 100 },
                        new() { Id = 23, Code = "2.3", Name = "UI/UX Design", Type = "Task", BudgetedHours = 80, ActualHours = 70, PercentComplete = 85 },
                    }
                },
                new()
                {
                    Id = 3, Code = "3.0", Name = "Development", Type = "Phase", BudgetedHours = 1000, ActualHours = 350, PercentComplete = 35, IsExpanded = false,
                    Children = new()
                    {
                        new() { Id = 31, Code = "3.1", Name = "Core Modules", Type = "Task", BudgetedHours = 400, ActualHours = 200, PercentComplete = 50 },
                        new() { Id = 32, Code = "3.2", Name = "Integration Layer", Type = "Task", BudgetedHours = 300, ActualHours = 100, PercentComplete = 33 },
                        new() { Id = 33, Code = "3.3", Name = "Reporting Module", Type = "Task", BudgetedHours = 300, ActualHours = 50, PercentComplete = 17 },
                    }
                },
                new()
                {
                    Id = 4, Code = "4.0", Name = "Testing & QA", Type = "Phase", BudgetedHours = 300, ActualHours = 31, PercentComplete = 10, IsExpanded = false,
                },
                new()
                {
                    Id = 5, Code = "5.0", Name = "Deployment & Training", Type = "Phase", BudgetedHours = 200, ActualHours = 0, PercentComplete = 0, IsExpanded = false,
                },
            };

            teamMembers = new List<TeamMember>
            {
                new() { Id = 1, Name = "Alice Johnson", Role = "Project Manager", ResourceType = "PM", AllocatedHours = 400, LoggedHours = 180, BillRate = 175 },
                new() { Id = 2, Name = "Bob Smith", Role = "Lead Developer", ResourceType = "Sr Developer", AllocatedHours = 600, LoggedHours = 270, BillRate = 200 },
                new() { Id = 3, Name = "Carol Williams", Role = "Business Analyst", ResourceType = "BA", AllocatedHours = 300, LoggedHours = 135, BillRate = 150 },
                new() { Id = 4, Name = "David Brown", Role = "Developer", ResourceType = "Developer", AllocatedHours = 400, LoggedHours = 180, BillRate = 150 },
                new() { Id = 5, Name = "Emily Davis", Role = "QA Engineer", ResourceType = "QA", AllocatedHours = 200, LoggedHours = 56, BillRate = 125 },
                new() { Id = 6, Name = "Frank Miller", Role = "UI/UX Designer", ResourceType = "Designer", AllocatedHours = 100, LoggedHours = 35, BillRate = 140 },
            };

            daysRemaining = project.EndDate.HasValue ? (int)(project.EndDate.Value - DateTime.Today).TotalDays : 0;
        }
        finally
        {
            isLoading = false;
        }
    }

    private RenderFragment RenderOverviewTab() => __builder =>
    {
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <div class="lg:col-span-2 space-y-6">
                <!-- Project Info -->
                <Card>
                    <Header><h3 class="font-semibold text-gray-900">Project Information</h3></Header>
                    <Body>
                        <div class="grid grid-cols-2 gap-4">
                            <div><p class="text-xs text-gray-500">Type</p><p class="font-medium">@project!.Type</p></div>
                            <div><p class="text-xs text-gray-500">Billing Mode</p><p class="font-medium">@project.BillingMode</p></div>
                            <div><p class="text-xs text-gray-500">Start Date</p><p class="font-medium">@project.StartDate.ToString("MMMM dd, yyyy")</p></div>
                            <div><p class="text-xs text-gray-500">End Date</p><p class="font-medium">@(project.EndDate?.ToString("MMMM dd, yyyy") ?? "TBD")</p></div>
                            <div><p class="text-xs text-gray-500">Project Manager</p><p class="font-medium">@(project.ProjectManager ?? "Unassigned")</p></div>
                            <div><p class="text-xs text-gray-500">Client</p><p class="font-medium">@(project.ClientName ?? "Internal")</p></div>
                        </div>
                        @if (!string.IsNullOrEmpty(project.Description))
                        {
                            <div class="mt-4 pt-4 border-t">
                                <p class="text-xs text-gray-500 mb-1">Description</p>
                                <p class="text-sm text-gray-700">@project.Description</p>
                            </div>
                        }
                    </Body>
                </Card>

                <!-- Recent Activity -->
                <Card>
                    <Header><h3 class="font-semibold text-gray-900">Recent Activity</h3></Header>
                    <Body>
                        <div class="space-y-4">
                            @foreach (var activity in GetRecentActivity())
                            {
                                <div class="flex items-start space-x-3">
                                    <div class="flex-shrink-0 w-8 h-8 rounded-full bg-teal-100 flex items-center justify-center">
                                        <svg class="w-4 h-4 text-teal-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                        </svg>
                                    </div>
                                    <div class="flex-1 min-w-0">
                                        <p class="text-sm text-gray-900">@activity.Description</p>
                                        <p class="text-xs text-gray-500">@activity.User • @activity.Time</p>
                                    </div>
                                </div>
                            }
                        </div>
                    </Body>
                </Card>
            </div>

            <!-- Right Column -->
            <div class="space-y-6">
                <!-- Budget Overview -->
                <Card>
                    <Header><h3 class="font-semibold text-gray-900">Budget Overview</h3></Header>
                    <Body>
                        <div class="space-y-4">
                            <div>
                                <div class="flex justify-between text-sm mb-1">
                                    <span class="text-gray-500">Spent</span>
                                    <span class="font-medium">$112,500 / @project!.Budget.ToString("C0")</span>
                                </div>
                                <div class="bg-gray-200 rounded-full h-2">
                                    <div class="bg-teal-500 h-2 rounded-full" style="width: 45%"></div>
                                </div>
                            </div>
                            <div>
                                <div class="flex justify-between text-sm mb-1">
                                    <span class="text-gray-500">Hours</span>
                                    <span class="font-medium">@hoursLogged / @project.BudgetedHours</span>
                                </div>
                                <div class="bg-gray-200 rounded-full h-2">
                                    <div class="bg-blue-500 h-2 rounded-full" style="width: @((hoursLogged / project.BudgetedHours * 100).ToString("F0"))%"></div>
                                </div>
                            </div>
                        </div>
                    </Body>
                </Card>

                <!-- Team Summary -->
                <Card>
                    <Header><h3 class="font-semibold text-gray-900">Team (@teamMembers.Count)</h3></Header>
                    <Body>
                        <div class="space-y-3">
                            @foreach (var member in teamMembers.Take(4))
                            {
                                <div class="flex items-center space-x-3">
                                    <div class="flex-shrink-0 h-8 w-8 rounded-full bg-gray-200 flex items-center justify-center text-xs font-medium">
                                        @GetInitials(member.Name)
                                    </div>
                                    <div class="flex-1 min-w-0">
                                        <p class="text-sm font-medium text-gray-900 truncate">@member.Name</p>
                                        <p class="text-xs text-gray-500">@member.Role</p>
                                    </div>
                                </div>
                            }
                            @if (teamMembers.Count > 4)
                            {
                                <button class="text-sm text-teal-600 hover:text-teal-800" @onclick="() => activeTab = 2">
                                    View all @teamMembers.Count members →
                                </button>
                            }
                        </div>
                    </Body>
                </Card>
            </div>
        </div>
    };

    private RenderFragment RenderWBSTab() => __builder =>
    {
        <Card>
            <Header>
                <div class="flex items-center justify-between">
                    <h3 class="font-semibold text-gray-900">Work Breakdown Structure</h3>
                    <Button Variant="primary" Size="sm">
                        <svg class="w-4 h-4 mr-1 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
                        </svg>
                        Add Phase
                    </Button>
                </div>
            </Header>
            <Body>
                <div class="space-y-2">
                    @foreach (var phase in wbsItems)
                    {
                        <div class="border rounded-lg">
                            <div class="flex items-center p-3 bg-gray-50 cursor-pointer hover:bg-gray-100" @onclick="() => phase.IsExpanded = !phase.IsExpanded">
                                <svg class="w-5 h-5 text-gray-400 mr-2 transition-transform @(phase.IsExpanded ? "rotate-90" : "")" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                                </svg>
                                <span class="font-mono text-sm text-gray-500 mr-3">@phase.Code</span>
                                <span class="font-medium text-gray-900 flex-1">@phase.Name</span>
                                <span class="text-sm text-gray-500 mr-4">@phase.ActualHours / @phase.BudgetedHours hrs</span>
                                <div class="w-24 flex items-center space-x-2">
                                    <div class="flex-1 bg-gray-200 rounded-full h-2">
                                        <div class="@GetProgressColor(phase.PercentComplete) h-2 rounded-full" style="width: @(phase.PercentComplete)%"></div>
                                    </div>
                                    <span class="text-xs text-gray-600 w-8">@phase.PercentComplete%</span>
                                </div>
                            </div>
                            @if (phase.IsExpanded && phase.Children.Any())
                            {
                                <div class="border-t">
                                    @foreach (var task in phase.Children)
                                    {
                                        <div class="flex items-center p-3 pl-10 hover:bg-gray-50 border-b last:border-b-0">
                                            <span class="font-mono text-sm text-gray-400 mr-3">@task.Code</span>
                                            <span class="text-gray-700 flex-1">@task.Name</span>
                                            <span class="text-sm text-gray-500 mr-4">@task.ActualHours / @task.BudgetedHours hrs</span>
                                            <div class="w-24 flex items-center space-x-2">
                                                <div class="flex-1 bg-gray-200 rounded-full h-2">
                                                    <div class="@GetProgressColor(task.PercentComplete) h-2 rounded-full" style="width: @(task.PercentComplete)%"></div>
                                                </div>
                                                <span class="text-xs text-gray-600 w-8">@task.PercentComplete%</span>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            </Body>
        </Card>
    };

    private RenderFragment RenderTeamTab() => __builder =>
    {
        <Card>
            <Header>
                <div class="flex items-center justify-between">
                    <h3 class="font-semibold text-gray-900">Project Team</h3>
                    <Button Variant="primary" Size="sm">Add Team Member</Button>
                </div>
            </Header>
            <Body>
                <table class="min-w-full">
                    <thead>
                        <tr class="border-b">
                            <th class="table-header">Team Member</th>
                            <th class="table-header">Role</th>
                            <th class="table-header">Resource Type</th>
                            <th class="table-header text-right">Allocated</th>
                            <th class="table-header text-right">Logged</th>
                            <th class="table-header text-right">Bill Rate</th>
                            <th class="table-header text-right">Utilization</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var member in teamMembers)
                        {
                            <tr class="border-b hover:bg-gray-50">
                                <td class="table-cell">
                                    <div class="flex items-center space-x-3">
                                        <div class="h-8 w-8 rounded-full bg-teal-100 flex items-center justify-center text-sm font-medium text-teal-800">
                                            @GetInitials(member.Name)
                                        </div>
                                        <span class="font-medium text-gray-900">@member.Name</span>
                                    </div>
                                </td>
                                <td class="table-cell">@member.Role</td>
                                <td class="table-cell text-gray-500">@member.ResourceType</td>
                                <td class="table-cell text-right">@member.AllocatedHours hrs</td>
                                <td class="table-cell text-right">@member.LoggedHours hrs</td>
                                <td class="table-cell text-right">@member.BillRate.ToString("C0")/hr</td>
                                <td class="table-cell text-right">
                                    <span class="@(member.LoggedHours / member.AllocatedHours > 0.9m ? "text-red-600" : "text-gray-900")">
                                        @((member.LoggedHours / member.AllocatedHours * 100).ToString("F0"))%
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </Body>
        </Card>
    };

    private RenderFragment RenderTimeExpensesTab() => __builder =>
    {
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            <Card>
                <Header><h3 class="font-semibold text-gray-900">Recent Time Entries</h3></Header>
                <Body>
                    <div class="space-y-3">
                        @for (int i = 0; i < 5; i++)
                        {
                            <div class="flex items-center justify-between p-3 bg-gray-50 rounded-lg">
                                <div>
                                    <p class="font-medium text-gray-900">Development - Core Module</p>
                                    <p class="text-sm text-gray-500">Bob Smith • @DateTime.Today.AddDays(-i).ToString("MMM dd")</p>
                                </div>
                                <span class="font-medium text-gray-900">@(6 + i % 3).0 hrs</span>
                            </div>
                        }
                    </div>
                    <div class="mt-4 text-center">
                        <button class="text-sm text-teal-600 hover:text-teal-800">View All Time Entries →</button>
                    </div>
                </Body>
            </Card>
            <Card>
                <Header><h3 class="font-semibold text-gray-900">Recent Expenses</h3></Header>
                <Body>
                    <div class="space-y-3">
                        <div class="flex items-center justify-between p-3 bg-gray-50 rounded-lg">
                            <div>
                                <p class="font-medium text-gray-900">Software License</p>
                                <p class="text-sm text-gray-500">Alice Johnson • Jan 15</p>
                            </div>
                            <span class="font-medium text-gray-900">$1,200.00</span>
                        </div>
                        <div class="flex items-center justify-between p-3 bg-gray-50 rounded-lg">
                            <div>
                                <p class="font-medium text-gray-900">Travel - Client Visit</p>
                                <p class="text-sm text-gray-500">Carol Williams • Jan 10</p>
                            </div>
                            <span class="font-medium text-gray-900">$850.00</span>
                        </div>
                        <div class="flex items-center justify-between p-3 bg-gray-50 rounded-lg">
                            <div>
                                <p class="font-medium text-gray-900">Training Materials</p>
                                <p class="text-sm text-gray-500">Alice Johnson • Jan 8</p>
                            </div>
                            <span class="font-medium text-gray-900">$350.00</span>
                        </div>
                    </div>
                    <div class="mt-4 text-center">
