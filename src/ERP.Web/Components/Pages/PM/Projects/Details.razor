    private string GetInitials(string name)
    {
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2) return $"{parts[0][0]}{parts[1][0]}".ToUpper();
        if (parts.Length == 1) return parts[0].Substring(0, Math.Min(2, parts[0].Length)).ToUpper();
        return "??";
    }

    private string GetTabClass(int index) => activeTab == index
        ? "border-b-2 border-teal-500 text-teal-600 py-4 px-1 text-sm font-medium"
        : "border-b-2 border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300 py-4 px-1 text-sm font-medium";

    private string GetStatusBadgeClass(string status) => status switch
    {
        "Active" => "px-3 py-1 rounded-full text-xs font-medium bg-green-100 text-green-800",
        "Draft" => "px-3 py-1 rounded-full text-xs font-medium bg-gray-100 text-gray-800",
        "OnHold" => "px-3 py-1 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800",
        "Completed" => "px-3 py-1 rounded-full text-xs font-medium bg-blue-100 text-blue-800",
        "Cancelled" => "px-3 py-1 rounded-full text-xs font-medium bg-red-100 text-red-800",
        _ => "px-3 py-1 rounded-full text-xs font-medium bg-gray-100 text-gray-800"
    };

    private string GetStatusDisplay(string status) => status == "OnHold" ? "On Hold" : status;

    private string GetProgressColor(int percent) => percent switch
    {
        100 => "bg-green-500",
        >= 75 => "bg-teal-500",
        >= 50 => "bg-blue-500",
        >= 25 => "bg-yellow-500",
        _ => "bg-gray-400"
    };
