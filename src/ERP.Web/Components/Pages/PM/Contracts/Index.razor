@page "/pm/contracts"
@using ERP.Application.PM.DTOs
@using ERP.Application.PM.Queries
@using ERP.Application.PM.Commands
@using ERP.Application.CRM.DTOs
@using ERP.Application.CRM.Queries
@using MediatR

@inject IMediator Mediator

<div class="container mx-auto px-4 py-8">
    <!-- Breadcrumb -->
    <nav class="text-sm text-gray-600 mb-4">
        <a href="/" class="hover:text-teal-600">Home</a>
        <span class="mx-2">/</span>
        <a href="/pm/projects" class="hover:text-teal-600">Project Management</a>
        <span class="mx-2">/</span>
        <span class="text-gray-900 font-medium">Contracts</span>
    </nav>

    <!-- Page Header -->
    <div class="flex items-center justify-between mb-6">
        <div>
            <h1 class="text-3xl font-bold text-gray-900">Contracts</h1>
            <p class="mt-1 text-sm text-gray-600">Manage client contracts, SOWs, and change orders</p>
        </div>
        <Button Variant="primary" OnClick="NavigateToCreate">
            <svg class="w-5 h-5 mr-2 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
            </svg>
            New Contract
        </Button>
    </div>

    <!-- Search and Filter Bar -->
    <Card Class="mb-6">
        <Body>
            <div class="grid grid-cols-1 md:grid-cols-5 gap-4">
                <FormField Label="Search">
                    <input type="text"
                           @bind="searchTerm"
                           @bind:event="oninput"
                           @onkeyup="HandleSearch"
                           class="form-input"
                           placeholder="Search contracts..." />
                </FormField>

                <FormField Label="Type">
                    <select @bind="filterType" @bind:after="HandleFilter" class="form-input">
                        <option value="">All Types</option>
                        <option value="MSA">Master Service Agreement</option>
                        <option value="SOW">Statement of Work</option>
                        <option value="ChangeOrder">Change Order</option>
                        <option value="NDA">Non-Disclosure Agreement</option>
                        <option value="Amendment">Amendment</option>
                    </select>
                </FormField>

                <FormField Label="Status">
                    <select @bind="filterStatus" @bind:after="HandleFilter" class="form-input">
                        <option value="">All Status</option>
                        <option value="Draft">Draft</option>
                        <option value="PendingApproval">Pending Approval</option>
                        <option value="Active">Active</option>
                        <option value="Expired">Expired</option>
                        <option value="Terminated">Terminated</option>
                    </select>
                </FormField>

                <FormField Label="Client">
                    <select @bind="filterClient" @bind:after="HandleFilter" class="form-input">
                        <option value="">All Clients</option>
                        @foreach (var client in clients)
                        {
                            <option value="@client.Id">@client.Name</option>
                        }
                    </select>
                </FormField>

                <FormField Label="&nbsp;">
                    <Button Variant="outline" OnClick="ClearFilters" Class="w-full">
                        Clear Filters
                    </Button>
                </FormField>
            </div>
        </Body>
    </Card>

    <!-- Contracts Table -->
    <DataTable Items="@filteredContracts"
               TItem="ContractListItem"
               IsLoading="@isLoading"
               EmptyMessage="No contracts found"
               ShowPagination="true"
               CurrentPage="@currentPage"
               CurrentPageChanged="@HandlePageChange"
               PageSize="10"
               TotalItems="@totalItems">
        <Columns>
            <tr>
                <th class="table-header">Contract #</th>
                <th class="table-header">Name</th>
                <th class="table-header">Client</th>
                <th class="table-header">Type</th>
                <th class="table-header">Value</th>
                <th class="table-header">Status</th>
                <th class="table-header">Dates</th>
                <th class="table-header text-right">Actions</th>
            </tr>
        </Columns>
        <Rows>
            @foreach (var contract in filteredContracts ?? Enumerable.Empty<ContractListItem>())
            {
                <tr class="table-row">
                    <td class="table-cell">
                        <span class="font-mono text-sm text-teal-600 font-medium">@contract.ContractNumber</span>
                    </td>
                    <td class="table-cell">
                        <div>
                            <div class="font-medium text-gray-900">@contract.Name</div>
                            @if (contract.LinkedProjects > 0)
                            {
                                <div class="text-xs text-gray-500">@contract.LinkedProjects linked project(s)</div>
                            }
                        </div>
                    </td>
                    <td class="table-cell">
                        <a href="/crm/clients/@contract.ClientId/details" class="text-teal-600 hover:text-teal-800 hover:underline">
                            @contract.ClientName
                        </a>
                    </td>
                    <td class="table-cell">
                        <span class="@GetTypeBadgeClass(contract.Type)">
                            @GetTypeDisplay(contract.Type)
                        </span>
                    </td>
                    <td class="table-cell">
                        <span class="font-medium text-gray-900">@contract.Value.ToString("C0")</span>
                    </td>
                    <td class="table-cell">
                        <span class="@GetStatusBadgeClass(contract.Status)">
                            @GetStatusDisplay(contract.Status)
                        </span>
                    </td>
                    <td class="table-cell text-sm text-gray-600">
                        <div>@contract.StartDate.ToString("MMM dd, yyyy")</div>
                        @if (contract.EndDate.HasValue)
                        {
                            <div class="text-xs">to @contract.EndDate.Value.ToString("MMM dd, yyyy")</div>
                        }
                    </td>
                    <td class="table-cell text-right">
                        <div class="flex items-center justify-end space-x-2">
                            <Button Variant="outline" Size="sm" OnClick="() => ViewDetails(contract.Id)">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                                </svg>
                            </Button>
                            <Button Variant="outline" Size="sm" OnClick="() => EditContract(contract.Id)">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                                </svg>
                            </Button>
                            <Button Variant="danger" Size="sm" OnClick="() => ConfirmDelete(contract.Id, contract.Name)">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                                </svg>
                            </Button>
                        </div>
                    </td>
                </tr>
            }
        </Rows>
    </DataTable>
</div>

<!-- Delete Confirmation Modal -->
<Modal @bind-IsOpen="showDeleteModal" Title="Delete Contract" Size="md">
    <Body>
        <div class="text-center py-4">
            <div class="mx-auto flex items-center justify-center h-12 w-12 rounded-full bg-red-100 mb-4">
                <svg class="h-6 w-6 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
                </svg>
            </div>
            <h3 class="text-lg font-semibold text-gray-900 mb-2">Delete Contract</h3>
            <p class="text-sm text-gray-600">
                Are you sure you want to delete <strong>@contractToDelete</strong>?
                This will unlink all associated projects.
            </p>
        </div>
    </Body>
    <Footer>
        <Button Variant="secondary" OnClick="CancelDelete">Cancel</Button>
        <Button Variant="danger" OnClick="DeleteContract" IsLoading="@isDeleting">Delete</Button>
    </Footer>
</Modal>

@code {
    [Inject] private NavigationManager? NavigationManager { get; set; }

    private bool isLoading = false;
    private bool isDeleting = false;
    private bool showDeleteModal = false;
    private string searchTerm = string.Empty;
    private string filterType = string.Empty;
    private string filterStatus = string.Empty;
    private string filterClient = string.Empty;
    private int currentPage = 1;
    private int totalItems = 0;
    private long deleteContractId = 0;
    private string contractToDelete = string.Empty;

    private List<ContractListItem>? allContracts;
    private List<ContractListItem>? filteredContracts;
    private List<ClientOption> clients = new();

    private class ContractListItem
    {
        public long Id { get; set; }
        public string ContractNumber { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
        public long ClientId { get; set; }
        public string ClientName { get; set; } = string.Empty;
        public string Type { get; set; } = string.Empty;
        public decimal Value { get; set; }
        public string Status { get; set; } = string.Empty;
        public DateTime StartDate { get; set; }
        public DateTime? EndDate { get; set; }
        public int LinkedProjects { get; set; }
    }

    private class ClientOption { public long Id { get; set; } public string Name { get; set; } = string.Empty; }

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            // Load contracts from backend
            var contractsQuery = new GetAllContractsQuery();
            var contractDtos = await Mediator.Send(contractsQuery);

            allContracts = contractDtos.Select(c => new ContractListItem
            {
                Id = c.Id,
                ContractNumber = c.ContractNumber,
                Name = c.Title ?? c.ContractNumber,
                ClientId = c.ClientId,
                ClientName = c.ClientName,
                Type = c.ContractType,
                Value = c.ContractValueAmount ?? 0,
                Status = c.IsActive ? "Active" : "Inactive",
                StartDate = c.StartDate,
                EndDate = c.EndDate,
                LinkedProjects = 1 // TODO: Add linked project count to DTO
            }).ToList();

            // Load clients for filter dropdown
            var clientsQuery = new GetAllClientsQuery();
            var clientDtos = await Mediator.Send(clientsQuery);

            clients = clientDtos.Select(c => new ClientOption
            {
                Id = c.Id,
                Name = c.Name
            }).ToList();

            ApplyFilters();
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ApplyFilters()
    {
        filteredContracts = allContracts;

        if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            var search = searchTerm.ToLower();
            filteredContracts = filteredContracts?
                .Where(c => c.Name.ToLower().Contains(search) ||
                           c.ContractNumber.ToLower().Contains(search) ||
                           c.ClientName.ToLower().Contains(search))
                .ToList();
        }

        if (!string.IsNullOrWhiteSpace(filterType))
        {
            filteredContracts = filteredContracts?.Where(c => c.Type == filterType).ToList();
        }

        if (!string.IsNullOrWhiteSpace(filterStatus))
        {
            filteredContracts = filteredContracts?.Where(c => c.Status == filterStatus).ToList();
        }

        if (!string.IsNullOrWhiteSpace(filterClient) && long.TryParse(filterClient, out var clientId))
        {
            filteredContracts = filteredContracts?.Where(c => c.ClientId == clientId).ToList();
        }

        totalItems = filteredContracts?.Count ?? 0;
        filteredContracts = filteredContracts?.Skip((currentPage - 1) * 10).Take(10).ToList();
    }

    private void HandleSearch() { currentPage = 1; ApplyFilters(); }
    private void HandleFilter() { currentPage = 1; ApplyFilters(); }
    private void ClearFilters() { searchTerm = filterType = filterStatus = filterClient = string.Empty; currentPage = 1; ApplyFilters(); }
    private async Task HandlePageChange(int page) { currentPage = page; ApplyFilters(); await Task.CompletedTask; }

    private void NavigateToCreate() => NavigationManager?.NavigateTo("/pm/contracts/create");
    private void ViewDetails(long id) => NavigationManager?.NavigateTo($"/pm/contracts/{id}/details");
    private void EditContract(long id) => NavigationManager?.NavigateTo($"/pm/contracts/{id}/edit");

    private void ConfirmDelete(long id, string name) { deleteContractId = id; contractToDelete = name; showDeleteModal = true; }
    private void CancelDelete() { showDeleteModal = false; }

    private async Task DeleteContract()
    {
        isDeleting = true;
        try
        {
            var command = new DeleteContractCommand { Id = deleteContractId };
            await Mediator.Send(command);
            allContracts?.RemoveAll(c => c.Id == deleteContractId);
            ApplyFilters();
            showDeleteModal = false;
        }
        finally { isDeleting = false; }
    }

    private string GetTypeBadgeClass(string type) => type switch
    {
        "MSA" => "px-3 py-1 rounded-full text-xs font-medium bg-teal-100 text-teal-800",
        "SOW" => "px-3 py-1 rounded-full text-xs font-medium bg-blue-100 text-blue-800",
        "ChangeOrder" => "px-3 py-1 rounded-full text-xs font-medium bg-orange-100 text-orange-800",
        "NDA" => "px-3 py-1 rounded-full text-xs font-medium bg-purple-100 text-purple-800",
        "Amendment" => "px-3 py-1 rounded-full text-xs font-medium bg-gray-100 text-gray-800",
        _ => "px-3 py-1 rounded-full text-xs font-medium bg-gray-100 text-gray-800"
    };

    private string GetTypeDisplay(string type) => type switch
    {
        "MSA" => "MSA",
        "SOW" => "SOW",
        "ChangeOrder" => "Change Order",
        "NDA" => "NDA",
        "Amendment" => "Amendment",
        _ => type
    };

    private string GetStatusBadgeClass(string status) => status switch
    {
        "Active" => "px-3 py-1 rounded-full text-xs font-medium bg-green-100 text-green-800",
        "Draft" => "px-3 py-1 rounded-full text-xs font-medium bg-gray-100 text-gray-800",
        "PendingApproval" => "px-3 py-1 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800",
        "Expired" => "px-3 py-1 rounded-full text-xs font-medium bg-red-100 text-red-800",
        "Terminated" => "px-3 py-1 rounded-full text-xs font-medium bg-red-100 text-red-800",
        _ => "px-3 py-1 rounded-full text-xs font-medium bg-gray-100 text-gray-800"
    };

    private string GetStatusDisplay(string status) => status switch
    {
        "PendingApproval" => "Pending Approval",
        _ => status
    };
}
