@page "/auth/forgot-password"
@layout LoginLayout
@using ERP.Web.Components.Shared

<div class="min-h-screen flex items-center justify-center bg-gray-50 py-12 px-4">
    <div class="w-full max-w-md">
        <div class="text-center mb-8">
            <h1 class="text-3xl font-bold text-gray-900">Forgot Password</h1>
            <p class="mt-2 text-sm text-gray-600">
                @if (emailSent)
                {
                    <span>Check your email for reset instructions</span>
                }
                else
                {
                    <span>Enter your email to reset your password</span>
                }
            </p>
        </div>

        <Card Class="shadow-md">
            <Body>
                @if (emailSent)
                {
                    <Alert Type="success" Title="Email Sent!" Dismissible="false">
                        <p>We've sent password reset instructions to <strong>@forgotPasswordModel.Email</strong></p>
                        <p class="mt-2 text-sm">Please check your inbox and follow the instructions to reset your password.</p>
                        <p class="mt-4 text-sm">Didn't receive the email? Check your spam folder or
                            <button @onclick="ResetForm" class="text-green-700 font-medium hover:text-green-900 underline">
                                try again
                            </button>
                        </p>
                    </Alert>

                    <div class="mt-6 text-center">
                        <a href="/auth/login" class="text-sm text-blue-600 hover:text-blue-800 font-medium">
                            Back to Sign In
                        </a>
                    </div>
                }
                else
                {
                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <Alert Type="error" Message="@errorMessage" Dismissible="true" OnDismiss="() => errorMessage = string.Empty" />
                    }

                    <div class="mb-6">
                        <div class="flex items-center justify-center w-12 h-12 bg-blue-100 rounded-full mx-auto">
                            <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                            </svg>
                        </div>
                        <p class="mt-4 text-sm text-gray-600 text-center">
                            Enter the email address associated with your account and we'll send you a link to reset your password.
                        </p>
                    </div>

                    <EditForm Model="@forgotPasswordModel" OnValidSubmit="HandleForgotPassword">
                        <DataAnnotationsValidator />

                        <FormField Label="Email Address" Required="true" Error="@GetFieldError(nameof(forgotPasswordModel.Email))">
                            <InputText type="email"
                                       @bind-Value="forgotPasswordModel.Email"
                                       class="form-input"
                                       placeholder="john.doe@company.com"
                                       disabled="@isLoading" />
                        </FormField>

                        <Button Type="submit"
                                Variant="primary"
                                Size="md"
                                IsLoading="@isLoading"
                                Disabled="@isLoading"
                                Class="w-full">
                            @(isLoading ? "Sending..." : "Send Reset Link")
                        </Button>
                    </EditForm>

                    <div class="mt-6 text-center">
                        <a href="/auth/login" class="text-sm text-blue-600 hover:text-blue-800 font-medium">
                            Back to Sign In
                        </a>
                    </div>
                }
            </Body>
        </Card>

        <div class="mt-4 text-center text-xs text-gray-500">
            <p>If you continue to have problems, please contact support</p>
        </div>
    </div>
</div>

@code {
    private ForgotPasswordModel forgotPasswordModel = new();
    private bool isLoading = false;
    private bool emailSent = false;
    private string? errorMessage;
    private Dictionary<string, List<string>> validationErrors = new();

    private class ForgotPasswordModel
    {
        [Required(ErrorMessage = "Email is required")]
        [EmailAddress(ErrorMessage = "Invalid email format")]
        public string Email { get; set; } = string.Empty;
    }

    private async Task HandleForgotPassword()
    {
        isLoading = true;
        errorMessage = null;
        validationErrors.Clear();

        try
        {
            // Simulate API call
            await Task.Delay(1500);

            // TODO: Call forgot password API
            // var result = await AuthService.ForgotPasswordAsync(forgotPasswordModel.Email);

            // Placeholder: Simulate successful email send
            emailSent = true;
        }
        catch (Exception ex)
        {
            errorMessage = "An error occurred while sending the reset link. Please try again.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ResetForm()
    {
        emailSent = false;
        forgotPasswordModel = new ForgotPasswordModel();
        errorMessage = null;
    }

    private string? GetFieldError(string fieldName)
    {
        return validationErrors.ContainsKey(fieldName) ? validationErrors[fieldName].FirstOrDefault() : null;
    }
}
