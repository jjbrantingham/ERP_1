@page "/auth/reset-password"
@layout LoginLayout
@using ERP.Web.Components.Shared
@using Microsoft.AspNetCore.WebUtilities

<div class="min-h-screen flex items-center justify-center bg-gray-50 py-12 px-4">
    <div class="w-full max-w-md">
        <div class="text-center mb-8">
            <h1 class="text-3xl font-bold text-gray-900">Reset Password</h1>
            <p class="mt-2 text-sm text-gray-600">
                @if (resetSuccess)
                {
                    <span>Your password has been reset</span>
                }
                else if (invalidToken)
                {
                    <span>Invalid or expired reset link</span>
                }
                else
                {
                    <span>Create a new password for your account</span>
                }
            </p>
        </div>

        <Card Class="shadow-md">
            <Body>
                @if (resetSuccess)
                {
                    <Alert Type="success" Title="Password Reset Successfully!" Dismissible="false">
                        <p>Your password has been reset successfully.</p>
                        <p class="mt-4">
                            <a href="/auth/login" class="text-green-700 font-medium hover:text-green-900">
                                Click here to sign in with your new password
                            </a>
                        </p>
                    </Alert>
                }
                else if (invalidToken)
                {
                    <Alert Type="error" Title="Invalid Reset Link" Dismissible="false">
                        <p>This password reset link is invalid or has expired.</p>
                        <p class="mt-4">
                            <a href="/auth/forgot-password" class="text-red-700 font-medium hover:text-red-900">
                                Request a new password reset link
                            </a>
                        </p>
                    </Alert>
                }
                else
                {
                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <Alert Type="error" Message="@errorMessage" Dismissible="true" OnDismiss="() => errorMessage = string.Empty" />
                    }

                    <div class="mb-6">
                        <div class="flex items-center justify-center w-12 h-12 bg-blue-100 rounded-full mx-auto">
                            <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
                            </svg>
                        </div>
                        <p class="mt-4 text-sm text-gray-600 text-center">
                            Please enter a new password for your account.
                        </p>
                    </div>

                    <EditForm Model="@resetPasswordModel" OnValidSubmit="HandleResetPassword">
                        <DataAnnotationsValidator />

                        <FormField Label="New Password" Required="true" Error="@GetFieldError(nameof(resetPasswordModel.Password))">
                            <div class="relative">
                                <InputText type="@(showPassword ? "text" : "password")"
                                           @bind-Value="resetPasswordModel.Password"
                                           class="form-input"
                                           placeholder="Enter new password"
                                           disabled="@isLoading"
                                           @oninput="OnPasswordInput" />
                                <button type="button"
                                        @onclick="() => showPassword = !showPassword"
                                        class="absolute right-3 top-1/2 transform -translate-y-1/2 text-gray-500 hover:text-gray-700"
                                        disabled="@isLoading">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="@(showPassword ? "M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21" : "M15 12a3 3 0 11-6 0 3 3 0 016 0z M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z")"></path>
                                    </svg>
                                </button>
                            </div>
                        </FormField>

                        @if (!string.IsNullOrEmpty(resetPasswordModel.Password))
                        {
                            <div class="mb-4 p-3 bg-gray-50 rounded border border-gray-200">
                                <p class="text-xs font-semibold text-gray-700 mb-2">Password Requirements:</p>
                                <ul class="space-y-1 text-xs">
                                    <li class="flex items-center @(resetPasswordModel.Password.Length >= 8 ? "text-green-600" : "text-gray-500")">
                                        <svg class="w-4 h-4 mr-1" fill="currentColor" viewBox="0 0 20 20">
                                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                                        </svg>
                                        At least 8 characters
                                    </li>
                                    <li class="flex items-center @(System.Text.RegularExpressions.Regex.IsMatch(resetPasswordModel.Password, "[A-Z]") ? "text-green-600" : "text-gray-500")">
                                        <svg class="w-4 h-4 mr-1" fill="currentColor" viewBox="0 0 20 20">
                                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                                        </svg>
                                        One uppercase letter
                                    </li>
                                    <li class="flex items-center @(System.Text.RegularExpressions.Regex.IsMatch(resetPasswordModel.Password, "[a-z]") ? "text-green-600" : "text-gray-500")">
                                        <svg class="w-4 h-4 mr-1" fill="currentColor" viewBox="0 0 20 20">
                                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                                        </svg>
                                        One lowercase letter
                                    </li>
                                    <li class="flex items-center @(System.Text.RegularExpressions.Regex.IsMatch(resetPasswordModel.Password, "[0-9]") ? "text-green-600" : "text-gray-500")">
                                        <svg class="w-4 h-4 mr-1" fill="currentColor" viewBox="0 0 20 20">
                                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                                        </svg>
                                        One number
                                    </li>
                                </ul>
                            </div>
                        }

                        <FormField Label="Confirm New Password" Required="true" Error="@GetFieldError(nameof(resetPasswordModel.ConfirmPassword))">
                            <InputText type="@(showConfirmPassword ? "text" : "password")"
                                       @bind-Value="resetPasswordModel.ConfirmPassword"
                                       class="form-input"
                                       placeholder="Re-enter new password"
                                       disabled="@isLoading" />
                        </FormField>

                        <Button Type="submit"
                                Variant="primary"
                                Size="md"
                                IsLoading="@isLoading"
                                Disabled="@isLoading"
                                Class="w-full">
                            @(isLoading ? "Resetting password..." : "Reset Password")
                        </Button>
                    </EditForm>

                    <div class="mt-6 text-center">
                        <a href="/auth/login" class="text-sm text-blue-600 hover:text-blue-800 font-medium">
                            Back to Sign In
                        </a>
                    </div>
                }
            </Body>
        </Card>
    </div>
</div>

@code {
    [Inject] private NavigationManager NavigationManager { get; set; } = default!;

    private ResetPasswordModel resetPasswordModel = new();
    private bool isLoading = false;
    private bool showPassword = false;
    private bool showConfirmPassword = false;
    private bool resetSuccess = false;
    private bool invalidToken = false;
    private string? errorMessage;
    private string? resetToken;
    private Dictionary<string, List<string>> validationErrors = new();

    private class ResetPasswordModel
    {
        [Required(ErrorMessage = "Password is required")]
        [MinLength(8, ErrorMessage = "Password must be at least 8 characters")]
        [RegularExpression(@"^(?=.*[a-z])(?=.*[A-Z])(?=.*\d).+$",
            ErrorMessage = "Password must contain at least one uppercase letter, one lowercase letter, and one number")]
        public string Password { get; set; } = string.Empty;

        [Required(ErrorMessage = "Please confirm your password")]
        [Compare(nameof(Password), ErrorMessage = "Passwords do not match")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }

    protected override void OnInitialized()
    {
        // Get reset token from query string
        var uri = new Uri(NavigationManager.Uri);
        if (QueryHelpers.ParseQuery(uri.Query).TryGetValue("token", out var token))
        {
            resetToken = token;

            // TODO: Validate token with API
            // ValidateResetToken(resetToken);

            // For demo: simulate token validation
            if (string.IsNullOrEmpty(resetToken))
            {
                invalidToken = true;
            }
        }
        else
        {
            invalidToken = true;
        }
    }

    private async Task HandleResetPassword()
    {
        if (string.IsNullOrEmpty(resetToken))
        {
            errorMessage = "Invalid reset token";
            return;
        }

        isLoading = true;
        errorMessage = null;
        validationErrors.Clear();

        try
        {
            // Simulate API call
            await Task.Delay(1500);

            // TODO: Call reset password API
            // var result = await AuthService.ResetPasswordAsync(resetToken, resetPasswordModel.Password);

            // Placeholder: Simulate successful password reset
            resetSuccess = true;
        }
        catch (Exception ex)
        {
            errorMessage = "An error occurred while resetting your password. Please try again.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OnPasswordInput(ChangeEventArgs e)
    {
        resetPasswordModel.Password = e.Value?.ToString() ?? string.Empty;
        StateHasChanged();
    }

    private string? GetFieldError(string fieldName)
    {
        return validationErrors.ContainsKey(fieldName) ? validationErrors[fieldName].FirstOrDefault() : null;
    }
}
