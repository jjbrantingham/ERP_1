@page "/auth/register"
@layout LoginLayout
@using ERP.Web.Components.Shared

<div class="min-h-screen flex items-center justify-center bg-gray-50 py-12 px-4">
    <div class="w-full max-w-md">
        <div class="text-center mb-8">
            <h1 class="text-3xl font-bold text-gray-900">Create Account</h1>
            <p class="mt-2 text-sm text-gray-600">Sign up for ERP System</p>
        </div>

        <Card Class="shadow-md">
            <Body>
                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <Alert Type="error" Message="@errorMessage" Dismissible="true" OnDismiss="() => errorMessage = string.Empty" />
                }

                @if (registrationSuccess)
                {
                    <Alert Type="success" Title="Registration Successful!" Dismissible="false">
                        <p>Your account has been created successfully.</p>
                        <p class="mt-2">
                            <a href="/auth/login" class="text-green-700 font-medium hover:text-green-900">
                                Click here to sign in
                            </a>
                        </p>
                    </Alert>
                }
                else
                {
                    <EditForm Model="@registerModel" OnValidSubmit="HandleRegister">
                        <DataAnnotationsValidator />

                        <div class="grid grid-cols-2 gap-4">
                            <FormField Label="First Name" Required="true" Error="@GetFieldError(nameof(registerModel.FirstName))">
                                <InputText @bind-Value="registerModel.FirstName"
                                           class="form-input"
                                           placeholder="John"
                                           disabled="@isLoading" />
                            </FormField>

                            <FormField Label="Last Name" Required="true" Error="@GetFieldError(nameof(registerModel.LastName))">
                                <InputText @bind-Value="registerModel.LastName"
                                           class="form-input"
                                           placeholder="Doe"
                                           disabled="@isLoading" />
                            </FormField>
                        </div>

                        <FormField Label="Email Address" Required="true" Error="@GetFieldError(nameof(registerModel.Email))">
                            <InputText type="email"
                                       @bind-Value="registerModel.Email"
                                       class="form-input"
                                       placeholder="john.doe@company.com"
                                       disabled="@isLoading" />
                        </FormField>

                        <FormField Label="Password" Required="true" Error="@GetFieldError(nameof(registerModel.Password))">
                            <div class="relative">
                                <InputText type="@(showPassword ? "text" : "password")"
                                           @bind-Value="registerModel.Password"
                                           class="form-input"
                                           placeholder="Create a strong password"
                                           disabled="@isLoading"
                                           @oninput="OnPasswordInput" />
                                <button type="button"
                                        @onclick="() => showPassword = !showPassword"
                                        class="absolute right-3 top-1/2 transform -translate-y-1/2 text-gray-500 hover:text-gray-700"
                                        disabled="@isLoading">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="@(showPassword ? "M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21" : "M15 12a3 3 0 11-6 0 3 3 0 016 0z M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z")"></path>
                                    </svg>
                                </button>
                            </div>
                        </FormField>

                        @if (!string.IsNullOrEmpty(registerModel.Password))
                        {
                            <div class="mb-4 p-3 bg-gray-50 rounded border border-gray-200">
                                <p class="text-xs font-semibold text-gray-700 mb-2">Password Requirements:</p>
                                <ul class="space-y-1 text-xs">
                                    <li class="flex items-center @(registerModel.Password.Length >= 8 ? "text-green-600" : "text-gray-500")">
                                        <svg class="w-4 h-4 mr-1" fill="currentColor" viewBox="0 0 20 20">
                                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                                        </svg>
                                        At least 8 characters
                                    </li>
                                    <li class="flex items-center @(System.Text.RegularExpressions.Regex.IsMatch(registerModel.Password, "[A-Z]") ? "text-green-600" : "text-gray-500")">
                                        <svg class="w-4 h-4 mr-1" fill="currentColor" viewBox="0 0 20 20">
                                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                                        </svg>
                                        One uppercase letter
                                    </li>
                                    <li class="flex items-center @(System.Text.RegularExpressions.Regex.IsMatch(registerModel.Password, "[a-z]") ? "text-green-600" : "text-gray-500")">
                                        <svg class="w-4 h-4 mr-1" fill="currentColor" viewBox="0 0 20 20">
                                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                                        </svg>
                                        One lowercase letter
                                    </li>
                                    <li class="flex items-center @(System.Text.RegularExpressions.Regex.IsMatch(registerModel.Password, "[0-9]") ? "text-green-600" : "text-gray-500")">
                                        <svg class="w-4 h-4 mr-1" fill="currentColor" viewBox="0 0 20 20">
                                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                                        </svg>
                                        One number
                                    </li>
                                </ul>
                            </div>
                        }

                        <FormField Label="Confirm Password" Required="true" Error="@GetFieldError(nameof(registerModel.ConfirmPassword))">
                            <InputText type="@(showConfirmPassword ? "text" : "password")"
                                       @bind-Value="registerModel.ConfirmPassword"
                                       class="form-input"
                                       placeholder="Re-enter your password"
                                       disabled="@isLoading" />
                        </FormField>

                        <div class="mb-6">
                            <div class="flex items-start">
                                <InputCheckbox @bind-Value="registerModel.AcceptTerms"
                                              id="accept-terms"
                                              class="h-4 w-4 text-blue-600 border-gray-300 rounded mt-1"
                                              disabled="@isLoading" />
                                <label for="accept-terms" class="ml-2 text-sm text-gray-700">
                                    I agree to the
                                    <a href="/terms" target="_blank" class="text-blue-600 hover:text-blue-800">Terms of Service</a>
                                    and
                                    <a href="/privacy" target="_blank" class="text-blue-600 hover:text-blue-800">Privacy Policy</a>
                                </label>
                            </div>
                            @if (showTermsError)
                            {
                                <p class="form-error">You must accept the terms and conditions</p>
                            }
                        </div>

                        <Button Type="submit"
                                Variant="primary"
                                Size="md"
                                IsLoading="@isLoading"
                                Disabled="@isLoading"
                                Class="w-full">
                            @(isLoading ? "Creating account..." : "Create Account")
                        </Button>
                    </EditForm>

                    <div class="mt-6 text-center">
                        <p class="text-sm text-gray-600">
                            Already have an account?
                            <a href="/auth/login" class="text-blue-600 hover:text-blue-800 font-medium">
                                Sign in
                            </a>
                        </p>
                    </div>
                }
            </Body>
        </Card>
    </div>
</div>

@code {
    private RegisterModel registerModel = new();
    private bool isLoading = false;
    private bool showPassword = false;
    private bool showConfirmPassword = false;
    private bool registrationSuccess = false;
    private bool showTermsError = false;
    private string? errorMessage;
    private Dictionary<string, List<string>> validationErrors = new();

    private class RegisterModel
    {
        [Required(ErrorMessage = "First name is required")]
        [StringLength(50, ErrorMessage = "First name cannot exceed 50 characters")]
        public string FirstName { get; set; } = string.Empty;

        [Required(ErrorMessage = "Last name is required")]
        [StringLength(50, ErrorMessage = "Last name cannot exceed 50 characters")]
        public string LastName { get; set; } = string.Empty;

        [Required(ErrorMessage = "Email is required")]
        [EmailAddress(ErrorMessage = "Invalid email format")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "Password is required")]
        [MinLength(8, ErrorMessage = "Password must be at least 8 characters")]
        [RegularExpression(@"^(?=.*[a-z])(?=.*[A-Z])(?=.*\d).+$",
            ErrorMessage = "Password must contain at least one uppercase letter, one lowercase letter, and one number")]
        public string Password { get; set; } = string.Empty;

        [Required(ErrorMessage = "Please confirm your password")]
        [Compare(nameof(Password), ErrorMessage = "Passwords do not match")]
        public string ConfirmPassword { get; set; } = string.Empty;

        public bool AcceptTerms { get; set; }
    }

    private async Task HandleRegister()
    {
        showTermsError = false;

        if (!registerModel.AcceptTerms)
        {
            showTermsError = true;
            return;
        }

        isLoading = true;
        errorMessage = null;
        validationErrors.Clear();

        try
        {
            // Simulate API call
            await Task.Delay(2000);

            // TODO: Call registration API
            // var result = await AuthService.RegisterAsync(registerModel);

            // Placeholder: Simulate successful registration
            registrationSuccess = true;
        }
        catch (Exception ex)
        {
            errorMessage = "An error occurred during registration. Please try again.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OnPasswordInput(ChangeEventArgs e)
    {
        registerModel.Password = e.Value?.ToString() ?? string.Empty;
        StateHasChanged();
    }

    private string? GetFieldError(string fieldName)
    {
        return validationErrors.ContainsKey(fieldName) ? validationErrors[fieldName].FirstOrDefault() : null;
    }
}
