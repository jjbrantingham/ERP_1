@page "/crm/clients/{Id:int}/details"

<div class="container mx-auto px-4 py-8">
    <!-- Breadcrumb -->
    <nav class="text-sm text-gray-600 mb-4">
        <a href="/" class="hover:text-blue-600">Home</a>
        <span class="mx-2">/</span>
        <a href="/crm/clients" class="hover:text-blue-600">Clients</a>
        <span class="mx-2">/</span>
        <span class="text-gray-900 font-medium">Details</span>
    </nav>

    @if (isLoading)
    {
        <div class="flex justify-center py-12">
            <LoadingSpinner />
        </div>
    }
    else if (client == null)
    {
        <Alert Type="error">Client not found</Alert>
    }
    else
    {
        <!-- Page Header -->
        <div class="flex flex-col md:flex-row md:items-start md:justify-between mb-6">
            <div class="flex items-start space-x-4">
                <div class="flex-shrink-0 h-16 w-16 rounded-full bg-gradient-to-br from-blue-500 to-purple-600 flex items-center justify-center text-white text-2xl font-bold">
                    @GetInitials(client.Name)
                </div>
                <div>
                    <div class="flex items-center space-x-3">
                        <h1 class="text-2xl font-bold text-gray-900">@client.Name</h1>
                        <span class="@GetStatusBadgeClass(client.Status)">@client.Status</span>
                    </div>
                    <p class="text-sm text-gray-500 mt-1">
                        <span class="font-mono text-blue-600 font-medium">@client.Code</span>
                        <span class="mx-2">•</span>
                        <span>@client.Industry</span>
                    </p>
                </div>
            </div>
            <div class="mt-4 md:mt-0 flex space-x-3">
                <Button Variant="secondary" OnClick="GoBack">Back</Button>
                <Button Variant="primary" OnClick="EditClient">Edit</Button>
            </div>
        </div>

        <!-- Tabs -->
        <div class="border-b border-gray-200 mb-6">
            <nav class="-mb-px flex space-x-8">
                <button @onclick="() => SetActiveTab(0)" class="@GetTabClass(0)">Overview</button>
                <button @onclick="() => SetActiveTab(1)" class="@GetTabClass(1)">Contacts (@contacts.Count)</button>
                <button @onclick="() => SetActiveTab(2)" class="@GetTabClass(2)">Projects (@projects.Count)</button>
                <button @onclick="() => SetActiveTab(3)" class="@GetTabClass(3)">Notes</button>
                <button @onclick="() => SetActiveTab(4)" class="@GetTabClass(4)">Activity</button>
            </nav>
        </div>

        @if (activeTab == 0)
        {
            <!-- Overview Tab -->
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                <div class="lg:col-span-2 space-y-6">
                    <Card>
                        <Header><h3 class="font-semibold text-gray-900">Company Information</h3></Header>
                        <Body>
                            <div class="grid grid-cols-2 gap-4">
                                <div><p class="text-xs text-gray-500">Legal Name</p><p class="font-medium">@(client.LegalName ?? "-")</p></div>
                                <div><p class="text-xs text-gray-500">Industry</p><p class="font-medium">@client.Industry</p></div>
                                <div><p class="text-xs text-gray-500">Website</p>
                                    @if (!string.IsNullOrEmpty(client.Website))
                                    {
                                        <a href="@client.Website" target="_blank" class="font-medium text-blue-600 hover:text-blue-800">@client.Website</a>
                                    }
                                    else
                                    {
                                        <p class="font-medium">-</p>
                                    }
                                </div>
                                <div><p class="text-xs text-gray-500">Client Since</p><p class="font-medium">@client.ClientSince.ToString("MMMM yyyy")</p></div>
                            </div>
                        </Body>
                    </Card>

                    <Card>
                        <Header><h3 class="font-semibold text-gray-900">Primary Contact</h3></Header>
                        <Body>
                            <div class="flex items-start space-x-4">
                                <div class="h-12 w-12 rounded-full bg-gray-200 flex items-center justify-center text-gray-600 font-medium">
                                    @GetInitials(client.PrimaryContactName)
                                </div>
                                <div>
                                    <p class="font-medium text-gray-900">@client.PrimaryContactName</p>
                                    <p class="text-sm text-gray-500">@(client.PrimaryContactTitle ?? "Contact")</p>
                                    <div class="mt-2 space-y-1">
                                        <p class="text-sm"><a href="mailto:@client.PrimaryContactEmail" class="text-blue-600 hover:text-blue-800">@client.PrimaryContactEmail</a></p>
                                        @if (!string.IsNullOrEmpty(client.PrimaryContactPhone))
                                        {
                                            <p class="text-sm text-gray-600">@client.PrimaryContactPhone</p>
                                        }
                                    </div>
                                </div>
                            </div>
                        </Body>
                    </Card>

                    <Card>
                        <Header><h3 class="font-semibold text-gray-900">Billing Information</h3></Header>
                        <Body>
                            <div class="grid grid-cols-2 gap-4">
                                <div><p class="text-xs text-gray-500">Payment Terms</p><p class="font-medium">@client.PaymentTerms</p></div>
                                <div><p class="text-xs text-gray-500">Credit Limit</p><p class="font-medium">@(client.CreditLimit?.ToString("C0") ?? "N/A")</p></div>
                                <div class="col-span-2">
                                    <p class="text-xs text-gray-500">Billing Address</p>
                                    <p class="font-medium">
                                        @client.BillingStreet<br />
                                        @client.BillingCity, @client.BillingState @client.BillingPostalCode<br />
                                        @client.BillingCountry
                                    </p>
                                </div>
                            </div>
                        </Body>
                    </Card>
                </div>

                <div class="space-y-6">
                    <Card>
                        <Header><h3 class="font-semibold text-gray-900">Quick Stats</h3></Header>
                        <Body>
                            <div class="space-y-3">
                                <div class="flex justify-between"><span class="text-sm text-gray-500">Active Projects</span><span class="font-medium">@projects.Count(p => p.Status == "Active")</span></div>
                                <div class="flex justify-between"><span class="text-sm text-gray-500">Total Projects</span><span class="font-medium">@projects.Count</span></div>
                                <div class="flex justify-between"><span class="text-sm text-gray-500">Contacts</span><span class="font-medium">@contacts.Count</span></div>
                                <div class="flex justify-between"><span class="text-sm text-gray-500">Total Revenue</span><span class="font-medium text-green-600">$485,000</span></div>
                                <div class="flex justify-between"><span class="text-sm text-gray-500">Outstanding</span><span class="font-medium text-yellow-600">$32,500</span></div>
                            </div>
                        </Body>
                    </Card>

                    <Card>
                        <Header><h3 class="font-semibold text-gray-900">Recent Activity</h3></Header>
                        <Body>
                            <div class="space-y-3">
                                @foreach (var activity in activities.Take(3))
                                {
                                    <div class="flex items-start space-x-2">
                                        <div class="flex-shrink-0 w-6 h-6 rounded-full bg-blue-100 flex items-center justify-center">
                                            <svg class="w-3 h-3 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                            </svg>
                                        </div>
                                        <div>
                                            <p class="text-sm text-gray-900">@activity.Description</p>
                                            <p class="text-xs text-gray-500">@activity.Time</p>
                                        </div>
                                    </div>
                                }
                            </div>
                        </Body>
                    </Card>
                </div>
            </div>
        }
        else if (activeTab == 1)
        {
            <!-- Contacts Tab -->
            <Card>
                <Header>
                    <div class="flex items-center justify-between">
                        <h3 class="font-semibold text-gray-900">Contacts</h3>
                        <Button Variant="primary" Size="sm" OnClick="AddContact">Add Contact</Button>
                    </div>
                </Header>
                <Body>
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                        @foreach (var contact in contacts)
                        {
                            <div class="border border-gray-200 rounded-lg p-4 hover:shadow-md transition-shadow">
                                <div class="flex items-start space-x-3">
                                    <div class="h-10 w-10 rounded-full bg-gray-200 flex items-center justify-center text-gray-600 font-medium">
                                        @GetInitials(contact.Name)
                                    </div>
                                    <div class="flex-1 min-w-0">
                                        <p class="font-medium text-gray-900 truncate">@contact.Name</p>
                                        <p class="text-sm text-gray-500">@contact.Title</p>
                                        <div class="mt-2">
                                            <a href="mailto:@contact.Email" class="text-sm text-blue-600 hover:text-blue-800 block truncate">@contact.Email</a>
                                            @if (!string.IsNullOrEmpty(contact.Phone))
                                            {
                                                <p class="text-sm text-gray-600">@contact.Phone</p>
                                            }
                                        </div>
                                        @if (contact.IsPrimary)
                                        {
                                            <span class="mt-2 inline-block px-2 py-0.5 rounded text-xs font-medium bg-blue-100 text-blue-800">Primary</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </Body>
            </Card>
        }
        else if (activeTab == 2)
        {
            <!-- Projects Tab -->
            <Card>
                <Header>
                    <div class="flex items-center justify-between">
                        <h3 class="font-semibold text-gray-900">Projects</h3>
                        <Button Variant="primary" Size="sm" OnClick="CreateProject">New Project</Button>
                    </div>
                </Header>
                <Body>
                    <table class="min-w-full divide-y divide-gray-200">
                        <thead class="bg-gray-50">
                            <tr>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Project</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Type</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Status</th>
                                <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase">Budget</th>
                                <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase">Progress</th>
                            </tr>
                        </thead>
                        <tbody class="bg-white divide-y divide-gray-200">
                            @foreach (var project in projects)
                            {
                                <tr class="hover:bg-gray-50 cursor-pointer">
                                    <td class="px-6 py-4">
                                        <div class="text-sm font-medium text-gray-900">@project.Name</div>
                                        <div class="text-xs text-gray-500">@project.Number</div>
                                    </td>
                                    <td class="px-6 py-4 text-sm text-gray-500">@project.Type</td>
                                    <td class="px-6 py-4">
                                        <span class="@GetProjectStatusBadgeClass(project.Status)">@project.Status</span>
                                    </td>
                                    <td class="px-6 py-4 text-sm text-right text-gray-900">@project.Budget.ToString("C0")</td>
                                    <td class="px-6 py-4">
                                        <div class="flex items-center justify-end">
                                            <div class="w-24 bg-gray-200 rounded-full h-2 mr-2">
                                                <div class="bg-blue-600 h-2 rounded-full" style="width: @(project.Progress)%"></div>
                                            </div>
                                            <span class="text-sm text-gray-600">@project.Progress%</span>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </Body>
            </Card>
        }
        else if (activeTab == 3)
        {
            <!-- Notes Tab -->
            <Card>
                <Header>
                    <div class="flex items-center justify-between">
                        <h3 class="font-semibold text-gray-900">Notes</h3>
                        <Button Variant="primary" Size="sm" OnClick="AddNote">Add Note</Button>
                    </div>
                </Header>
                <Body>
                    <div class="space-y-4">
                        @foreach (var note in notes)
                        {
                            <div class="border-l-4 border-blue-500 pl-4 py-2">
                                <div class="flex items-center justify-between mb-2">
                                    <span class="text-sm font-medium text-gray-900">@note.Author</span>
                                    <span class="text-xs text-gray-500">@note.Date</span>
                                </div>
                                <p class="text-sm text-gray-700">@note.Content</p>
                            </div>
                        }
                    </div>
                </Body>
            </Card>
        }
        else if (activeTab == 4)
        {
            <!-- Activity Tab -->
            <Card>
                <Header><h3 class="font-semibold text-gray-900">Activity History</h3></Header>
                <Body>
                    <div class="flow-root">
                        <ul class="-mb-8">
                            @foreach (var (activity, index) in activities.Select((a, i) => (a, i)))
                            {
                                <li>
                                    <div class="relative pb-8">
                                        @if (index < activities.Count - 1)
                                        {
                                            <span class="absolute top-4 left-4 -ml-px h-full w-0.5 bg-gray-200"></span>
                                        }
                                        <div class="relative flex space-x-3">
                                            <div>
                                                <span class="h-8 w-8 rounded-full bg-blue-100 flex items-center justify-center ring-8 ring-white">
                                                    <svg class="h-4 w-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="@activity.Icon"></path>
                                                    </svg>
                                                </span>
                                            </div>
                                            <div class="min-w-0 flex-1 pt-1.5">
                                                <p class="text-sm text-gray-900">@activity.Description</p>
                                                <p class="mt-0.5 text-xs text-gray-500">@activity.Time by @activity.User</p>
                                            </div>
                                        </div>
                                    </div>
                                </li>
                            }
                        </ul>
                    </div>
                </Body>
            </Card>
        }
    }
</div>

@code {
    [Parameter] public int Id { get; set; }
    [Inject] private NavigationManager? NavigationManager { get; set; }

    private ClientDetail? client;
    private bool isLoading = true;
    private int activeTab = 0;
    private List<ContactItem> contacts = new();
    private List<ProjectItem> projects = new();
    private List<NoteItem> notes = new();
    private List<ActivityItem> activities = new();

    private class ClientDetail
    {
        public long Id { get; set; }
        public string Code { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
        public string? LegalName { get; set; }
        public string Industry { get; set; } = string.Empty;
        public string? Website { get; set; }
        public string Status { get; set; } = string.Empty;
        public DateTime ClientSince { get; set; }
        public string PrimaryContactName { get; set; } = string.Empty;
        public string? PrimaryContactTitle { get; set; }
        public string PrimaryContactEmail { get; set; } = string.Empty;
        public string? PrimaryContactPhone { get; set; }
        public string? BillingStreet { get; set; }
        public string? BillingCity { get; set; }
        public string? BillingState { get; set; }
        public string? BillingPostalCode { get; set; }
        public string? BillingCountry { get; set; }
        public string PaymentTerms { get; set; } = "Net30";
        public decimal? CreditLimit { get; set; }
    }

    private class ContactItem
    {
        public long Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public string Title { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string? Phone { get; set; }
        public bool IsPrimary { get; set; }
    }

    private class ProjectItem
    {
        public long Id { get; set; }
        public string Number { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
        public string Type { get; set; } = string.Empty;
        public string Status { get; set; } = string.Empty;
        public decimal Budget { get; set; }
        public int Progress { get; set; }
    }

    private class NoteItem
    {
        public long Id { get; set; }
        public string Author { get; set; } = string.Empty;
        public string Date { get; set; } = string.Empty;
        public string Content { get; set; } = string.Empty;
    }

    private class ActivityItem
    {
        public string Description { get; set; } = string.Empty;
        public string Time { get; set; } = string.Empty;
        public string User { get; set; } = string.Empty;
        public string Icon { get; set; } = "M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z";
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            await Task.Delay(500);

            client = new ClientDetail
            {
                Id = Id,
                Code = "CLI-001",
                Name = "Acme Corporation",
                LegalName = "Acme Corporation Inc.",
                Industry = "Technology",
                Website = "https://www.acme.com",
                Status = "Active",
                ClientSince = DateTime.Now.AddYears(-3),
                PrimaryContactName = "John Davis",
                PrimaryContactTitle = "VP of Engineering",
                PrimaryContactEmail = "john.davis@acme.com",
                PrimaryContactPhone = "+1 (555) 123-4567",
                BillingStreet = "123 Tech Park Drive",
                BillingCity = "San Francisco",
                BillingState = "CA",
                BillingPostalCode = "94105",
                BillingCountry = "United States",
                PaymentTerms = "Net 30",
                CreditLimit = 100000
            };

            contacts = new List<ContactItem>
            {
                new() { Id = 1, Name = "John Davis", Title = "VP of Engineering", Email = "john.davis@acme.com", Phone = "+1 (555) 123-4567", IsPrimary = true },
                new() { Id = 2, Name = "Sarah Miller", Title = "Project Manager", Email = "sarah.miller@acme.com", Phone = "+1 (555) 234-5678", IsPrimary = false },
                new() { Id = 3, Name = "Mike Chen", Title = "Technical Lead", Email = "mike.chen@acme.com", IsPrimary = false },
                new() { Id = 4, Name = "Lisa Wong", Title = "Finance Director", Email = "lisa.wong@acme.com", Phone = "+1 (555) 345-6789", IsPrimary = false },
            };

            projects = new List<ProjectItem>
            {
                new() { Id = 1, Number = "PRJ-2024-001", Name = "Platform Modernization", Type = "Billable", Status = "Active", Budget = 250000, Progress = 65 },
                new() { Id = 2, Number = "PRJ-2024-005", Name = "API Integration", Type = "Billable", Status = "Active", Budget = 85000, Progress = 30 },
                new() { Id = 3, Number = "PRJ-2023-012", Name = "Security Audit", Type = "Billable", Status = "Completed", Budget = 45000, Progress = 100 },
            };

            notes = new List<NoteItem>
            {
                new() { Id = 1, Author = "Jane Smith", Date = "Jan 20, 2024", Content = "Discussed upcoming project timeline with John. They're looking to accelerate the platform modernization effort." },
                new() { Id = 2, Author = "Bob Wilson", Date = "Jan 15, 2024", Content = "Sent updated proposal for Q2 work. Waiting for budget approval from their finance team." },
                new() { Id = 3, Author = "Jane Smith", Date = "Jan 10, 2024", Content = "Initial meeting went well. Very interested in our cloud migration services." },
            };

            activities = new List<ActivityItem>
            {
                new() { Description = "Invoice #INV-2024-042 paid", Time = "2 hours ago", User = "System", Icon = "M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" },
                new() { Description = "New project created: API Integration", Time = "Yesterday", User = "Jane Smith", Icon = "M12 6v6m0 0v6m0-6h6m-6 0H6" },
                new() { Description = "Contact added: Lisa Wong", Time = "3 days ago", User = "Bob Wilson", Icon = "M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z" },
                new() { Description = "Status changed to Active", Time = "1 week ago", User = "Jane Smith", Icon = "M5 13l4 4L19 7" },
                new() { Description = "Client record created", Time = "3 years ago", User = "Admin", Icon = "M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" },
            };
        }
        finally
        {
            isLoading = false;
        }
    }

    private void SetActiveTab(int tab) => activeTab = tab;
    private void GoBack() => NavigationManager?.NavigateTo("/crm/clients");
    private void EditClient() => NavigationManager?.NavigateTo($"/crm/clients/{Id}");
    private void AddContact() => NavigationManager?.NavigateTo($"/crm/contacts/create?clientId={Id}");
    private void CreateProject() => NavigationManager?.NavigateTo($"/pm/projects/create?clientId={Id}");
    private void AddNote() { }

    private string GetInitials(string name)
    {
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2) return $"{parts[0][0]}{parts[1][0]}".ToUpper();
        return parts.Length == 1 ? parts[0].Substring(0, Math.Min(2, parts[0].Length)).ToUpper() : "??";
    }

    private string GetTabClass(int index) => activeTab == index
        ? "border-b-2 border-blue-500 text-blue-600 py-4 px-1 text-sm font-medium"
        : "border-b-2 border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300 py-4 px-1 text-sm font-medium";

    private string GetStatusBadgeClass(string status) => status switch
    {
        "Active" => "px-3 py-1 rounded-full text-xs font-medium bg-green-100 text-green-800",
        "Inactive" => "px-3 py-1 rounded-full text-xs font-medium bg-gray-100 text-gray-800",
        "Prospect" => "px-3 py-1 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800",
        _ => "px-3 py-1 rounded-full text-xs font-medium bg-gray-100 text-gray-800"
    };

    private string GetProjectStatusBadgeClass(string status) => status switch
    {
        "Active" => "px-2 py-1 rounded-full text-xs font-medium bg-green-100 text-green-800",
        "Completed" => "px-2 py-1 rounded-full text-xs font-medium bg-blue-100 text-blue-800",
        "OnHold" => "px-2 py-1 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800",
        _ => "px-2 py-1 rounded-full text-xs font-medium bg-gray-100 text-gray-800"
    };
}
