@page "/crm/clients"
@using ERP.Application.CRM.DTOs
@using ERP.Application.CRM.Queries
@using MediatR
@inject IMediator Mediator

<div class="container mx-auto px-4 py-8">
    <!-- Breadcrumb -->
    <nav class="text-sm text-gray-600 mb-4">
        <a href="/" class="hover:text-blue-600">Home</a>
        <span class="mx-2">/</span>
        <span class="text-gray-900 font-medium">Clients</span>
    </nav>

    <!-- Page Header -->
    <div class="flex items-center justify-between mb-6">
        <div>
            <h1 class="text-3xl font-bold text-gray-900">Clients</h1>
            <p class="mt-1 text-sm text-gray-600">Manage your client relationships</p>
        </div>
        <Button Variant="primary" OnClick="NavigateToCreate">
            <svg class="w-5 h-5 mr-2 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
            </svg>
            Add Client
        </Button>
    </div>

    <!-- Filters -->
    <Card Class="mb-6">
        <Body>
            <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
                <FormField Label="Search">
                    <input type="text" @bind="searchTerm" @bind:event="oninput" class="form-input" placeholder="Search clients..." />
                </FormField>

                <FormField Label="Industry">
                    <select @bind="filterIndustry" @bind:after="ApplyFilters" class="form-input">
                        <option value="">All Industries</option>
                        @foreach (var industry in GetUniqueIndustries())
                        {
                            <option value="@industry">@industry</option>
                        }
                    </select>
                </FormField>

                <FormField Label="Status">
                    <select @bind="filterStatus" @bind:after="ApplyFilters" class="form-input">
                        <option value="">All Status</option>
                        <option value="Active">Active</option>
                        <option value="Inactive">Inactive</option>
                        <option value="Prospect">Prospect</option>
                    </select>
                </FormField>

                <FormField Label="&nbsp;">
                    <Button Variant="outline" OnClick="ClearFilters" Class="w-full">Clear Filters</Button>
                </FormField>
            </div>
        </Body>
    </Card>

    @if (isLoading)
    {
        <div class="flex justify-center py-12">
            <LoadingSpinner />
        </div>
    }
    else
    {
        <!-- Stats Cards -->
        <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-6">
            <Card>
                <Body>
                    <div class="text-center">
                        <p class="text-2xl font-bold text-blue-600">@clients.Count</p>
                        <p class="text-sm text-gray-500">Total Clients</p>
                    </div>
                </Body>
            </Card>
            <Card>
                <Body>
                    <div class="text-center">
                        <p class="text-2xl font-bold text-green-600">@clients.Count(c => c.Status == "Active")</p>
                        <p class="text-sm text-gray-500">Active</p>
                    </div>
                </Body>
            </Card>
            <Card>
                <Body>
                    <div class="text-center">
                        <p class="text-2xl font-bold text-yellow-600">@clients.Count(c => c.Status == "Prospect")</p>
                        <p class="text-sm text-gray-500">Prospects</p>
                    </div>
                </Body>
            </Card>
            <Card>
                <Body>
                    <div class="text-center">
                        <p class="text-2xl font-bold text-purple-600">@clients.Sum(c => c.ActiveProjects)</p>
                        <p class="text-sm text-gray-500">Active Projects</p>
                    </div>
                </Body>
            </Card>
        </div>

        <Card>
            <Body>
                <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-gray-50">
                        <tr>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Client</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Industry</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Contact</th>
                            <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase">Projects</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Status</th>
                            <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-gray-200">
                        @foreach (var client in filteredClients ?? clients)
                        {
                            <tr class="hover:bg-gray-50 cursor-pointer" @onclick="() => ViewClient(client.Id)">
                                <td class="px-6 py-4">
                                    <div class="flex items-center">
                                        <div class="h-10 w-10 rounded-full bg-gradient-to-br from-blue-500 to-purple-600 flex items-center justify-center text-white font-bold">
                                            @GetInitials(client.Name)
                                        </div>
                                        <div class="ml-4">
                                            <div class="text-sm font-medium text-gray-900">@client.Name</div>
                                            <div class="text-xs text-gray-500">@client.Code</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="px-6 py-4 text-sm text-gray-500">@client.Industry</td>
                                <td class="px-6 py-4">
                                    <div class="text-sm text-gray-900">@client.PrimaryContact</div>
                                    <div class="text-xs text-gray-500">@client.Email</div>
                                </td>
                                <td class="px-6 py-4 text-center">
                                    <span class="text-sm font-medium text-gray-900">@client.ActiveProjects</span>
                                </td>
                                <td class="px-6 py-4">
                                    <span class="@GetStatusBadgeClass(client.Status)">@client.Status</span>
                                </td>
                                <td class="px-6 py-4 text-right" @onclick:stopPropagation="true">
                                    <div class="flex items-center justify-end space-x-2">
                                        <Button Variant="outline" Size="sm" OnClick="() => EditClient(client.Id)">Edit</Button>
                                        <Button Variant="danger" Size="sm" OnClick="() => ConfirmDelete(client)">Delete</Button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                @if ((filteredClients ?? clients).Count == 0)
                {
                    <div class="text-center py-12">
                        <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
                        </svg>
                        <h3 class="mt-2 text-sm font-medium text-gray-900">No clients found</h3>
                        <p class="mt-1 text-sm text-gray-500">Get started by adding a new client.</p>
                    </div>
                }
            </Body>
        </Card>
    }
</div>

<!-- Delete Confirmation Modal -->
<Modal @bind-IsOpen="showDeleteModal" Title="Delete Client" Size="md">
    <Body>
        <div class="text-center py-4">
            <div class="mx-auto flex items-center justify-center h-12 w-12 rounded-full bg-red-100 mb-4">
                <svg class="h-6 w-6 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
                </svg>
            </div>
            <p class="text-sm text-gray-600">
                Are you sure you want to delete <strong>@clientToDelete?.Name</strong>?
                This will also remove all associated contacts and notes.
            </p>
        </div>
    </Body>
    <Footer>
        <Button Variant="secondary" OnClick="CancelDelete">Cancel</Button>
        <Button Variant="danger" OnClick="DeleteClient" IsLoading="@isDeleting">Delete</Button>
    </Footer>
</Modal>

@code {
    [Inject] private NavigationManager? NavigationManager { get; set; }

    private bool isLoading = true;
    private bool isDeleting = false;
    private bool showDeleteModal = false;
    private string searchTerm = string.Empty;
    private string filterIndustry = string.Empty;
    private string filterStatus = string.Empty;
    private List<ClientItem> clients = new();
    private List<ClientItem>? filteredClients;
    private ClientItem? clientToDelete;

    private class ClientItem
    {
        public long Id { get; set; }
        public string Code { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
        public string Industry { get; set; } = string.Empty;
        public string PrimaryContact { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string Status { get; set; } = string.Empty;
        public int ActiveProjects { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            var clientsResult = await Mediator!.Send(new GetAllClientsQuery { ActiveOnly = false });
            clients = clientsResult.Select(c => new ClientItem
            {
                Id = c.Id,
                Code = c.ClientNumber,
                Name = c.Name,
                Industry = c.Industry ?? "N/A",
                PrimaryContact = "N/A", // Will be populated from primary contact
                Email = c.PrimaryEmail ?? "N/A",
                Status = c.Status,
                ActiveProjects = 0 // TODO: Get from projects module when available
            }).ToList();
            ApplyFilters();
        }
        catch (Exception ex)
        {
            // Log error and show empty list
            clients = new List<ClientItem>();
            Console.WriteLine($"Error loading clients: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ApplyFilters()
    {
        filteredClients = clients;

        if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            var search = searchTerm.ToLower();
            filteredClients = filteredClients.Where(c =>
                c.Name.ToLower().Contains(search) ||
                c.Code.ToLower().Contains(search) ||
                c.PrimaryContact.ToLower().Contains(search)
            ).ToList();
        }

        if (!string.IsNullOrWhiteSpace(filterIndustry))
            filteredClients = filteredClients.Where(c => c.Industry == filterIndustry).ToList();

        if (!string.IsNullOrWhiteSpace(filterStatus))
            filteredClients = filteredClients.Where(c => c.Status == filterStatus).ToList();
    }

    private void ClearFilters()
    {
        searchTerm = filterIndustry = filterStatus = string.Empty;
        ApplyFilters();
    }

    private void NavigateToCreate() => NavigationManager?.NavigateTo("/crm/clients/create");
    private void ViewClient(long id) => NavigationManager?.NavigateTo($"/crm/clients/{id}/details");
    private void EditClient(long id) => NavigationManager?.NavigateTo($"/crm/clients/{id}");

    private void ConfirmDelete(ClientItem client)
    {
        clientToDelete = client;
        showDeleteModal = true;
    }

    private void CancelDelete() => showDeleteModal = false;

    private async Task DeleteClient()
    {
        isDeleting = true;
        try
        {
            // TODO: Implement delete when DeleteClientCommand is available
            // await Mediator!.Send(new DeleteClientCommand { Id = clientToDelete!.Id });

            // For now, just remove from the list locally
            if (clientToDelete != null)
                clients.Remove(clientToDelete);
            showDeleteModal = false;
            ApplyFilters();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error deleting client: {ex.Message}");
        }
        finally
        {
            isDeleting = false;
        }
    }

    private List<string> GetUniqueIndustries()
    {
        return clients
            .Where(c => !string.IsNullOrEmpty(c.Industry) && c.Industry != "N/A")
            .Select(c => c.Industry)
            .Distinct()
            .OrderBy(i => i)
            .ToList();
    }

    private string GetInitials(string name)
    {
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2) return $"{parts[0][0]}{parts[1][0]}".ToUpper();
        return parts.Length == 1 ? parts[0].Substring(0, Math.Min(2, parts[0].Length)).ToUpper() : "??";
    }

    private string GetStatusBadgeClass(string status) => status switch
    {
        "Active" => "px-2 py-1 rounded-full text-xs font-medium bg-green-100 text-green-800",
        "Inactive" => "px-2 py-1 rounded-full text-xs font-medium bg-gray-100 text-gray-800",
        "Prospect" => "px-2 py-1 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800",
        _ => "px-2 py-1 rounded-full text-xs font-medium bg-gray-100 text-gray-800"
    };
}
